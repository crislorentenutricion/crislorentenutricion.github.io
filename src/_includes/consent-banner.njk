<div id="cln-consent-banner" class="cln-consent-banner" hidden role="dialog" aria-labelledby="cln-consent-title">
  <div class="cln-consent-banner__inner">
    <p class="cln-consent-banner__text">
      <strong id="cln-consent-title">Cookies y privacidad</strong><br>
      La web funciona sin cookies. Si aceptas, uso cookies de terceros para ver cómo se usa la web (Amplitude)
      y para medir el resultado de mis anuncios (Google, Meta). Si las rechazas, no se carga nada de eso.
      Puedes cambiar de opinión cuando quieras en «Configurar cookies», al pie de la página.
      Más info en la <a href="/legal/privacidad/#cookies">política de privacidad</a>.
    </p>
    <div class="cln-consent-banner__actions">
      <button type="button" class="cln-consent-banner__btn" data-consent-accept>Aceptar</button>
      <button type="button" class="cln-consent-banner__btn" data-consent-reject>Rechazar</button>
    </div>
  </div>
</div>
<script>
  // Muestra el banner en el primer pintado (antes era el LCP móvil y aparecía tarde).
  // tracking.js conecta los botones y lo cierra; misma clave y criterio que readConsent.
  (function () {
    var c = null;
    try { c = window.localStorage.getItem('cln_consent_v1'); } catch (_) {}
    if (c !== 'accepted' && c !== 'rejected') document.getElementById('cln-consent-banner').hidden = false;
  })();
</script>
