<a href="/blog/{{ post.urlCategory }}/{{ post.slug }}/" class="blog-card-link" data-category="{{ post.category }}">
  <article class="blog-card card">
    <div class="blog-card-img-wrap">
      {% if post.image %}
        <picture>
          <source srcset="/img/blog/{{ post.image | replace('.jpg', '.webp') }}" type="image/webp">
          <img src="/img/blog/{{ post.image }}" alt="{{ post.imageAlt }}" class="blog-card-img" loading="lazy" decoding="async" width="400" height="200">
        </picture>
      {% else %}
        <div class="blog-img-placeholder"></div>
      {% endif %}
    </div>
    <div class="blog-content">
      {% if post.categoryLabel %}<span class="blog-category">{{ post.categoryLabel }}</span>{% endif %}
      <h3>{{ post.title }}</h3>
      <p>{{ post.description }}</p>
      <span class="blog-date">{{ post.date | fechaEs }}</span>
    </div>
  </article>
</a>
