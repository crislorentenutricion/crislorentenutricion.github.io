{#
  Componente compartido: hint-box con botón "Ver guía visual" que abre
  el modal #modal-medidas. Lo usan el flujo de anamnesis (/empezar/) y
  el de revisión (/revision/). El modal #modal-medidas lo declara cada
  página — este componente solo es el callout.

  Estilos: src/mi-seguimiento/onboarding.css (común a /empezar/ y /revision/).

  Uso:
    {%- import "onb-hint-medidas.njk" as hintMedidas -%}
    ...
    {{ hintMedidas.render('<strong>¿Cómo medirte?</strong> Ponte de pie...') }}
#}

{% macro render(body) %}
<div class="onb-hint-box onb-hint-with-action">
  <div>{{ body | safe }}</div>
  <button type="button" class="onb-guide-btn" data-open-modal="medidas">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
    Ver guía visual
  </button>
</div>
{% endmacro %}
