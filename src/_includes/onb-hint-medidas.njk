{#
  Componente compartido: hint-box con botón "Ver guía visual" que abre
  el modal #modal-medidas. Lo usan el flujo de anamnesis (/empezar/) y
  el de revisión (/revision/). El modal #modal-medidas lo declara cada
  página — este componente solo es el callout.

  Uso:
    {%- import "onb-hint-medidas.njk" as hintMedidas -%}
    ...
    {{ hintMedidas.render('<strong>¿Cómo medirte?</strong> Ponte de pie...') }}
    ...
    <style>
      {{ hintMedidas.styles() | safe }}
    </style>
#}

{% macro styles() %}
  .onb-hint-with-action {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .onb-hint-with-action > div { flex: 1 1 260px; }
  .onb-guide-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 100px;
    border: 1.5px solid var(--color-green);
    background: var(--color-white);
    color: var(--color-green-dark);
    font-family: var(--font-family);
    font-size: 0.88rem;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }
  .onb-guide-btn:hover {
    background: var(--color-green);
    color: var(--color-white);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--color-green-glow);
  }
  .onb-guide-btn svg { flex-shrink: 0; }
  @media (max-width: 640px) {
    .onb-hint-with-action { flex-direction: column; align-items: stretch; gap: 10px; }
    .onb-hint-with-action > div { flex: 0 0 auto; }
    .onb-guide-btn { justify-content: center; }
  }
{% endmacro %}

{% macro render(body) %}
<div class="onb-hint-box onb-hint-with-action">
  <div>{{ body | safe }}</div>
  <button type="button" class="onb-guide-btn" data-open-modal="medidas">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
    Ver guía visual
  </button>
</div>
{% endmacro %}
