{#
  Componente compartido: modal "Guía visual — Cómo tomarte las medidas".
  Mismo contenido en /empezar/ y /revision/ (antes duplicado inline en
  ambos ficheros — markup + estilos).

  El scroll vive DENTRO del modal (`max-height: 100dvh - 40px` + `overflow-y: auto`).
  Antes el scroll estaba en el backdrop (`display: flex + overflow-y: auto`) y
  en móvil el touch no llegaba al backdrop por culpa del `backdrop-filter`: el
  contenido quedaba cortado sin forma de desplazarse. Con scroll interno el
  comportamiento es predecible en iOS Safari + Chrome.

  En móvil cada tarjeta se apila (imagen centrada arriba + título + texto
  abajo) en lugar del grid 80px | 1fr anterior — igual de legible que las
  cards editoriales de /seguimiento/, sin líneas de texto cortísimas.

  Uso:
    {%- import "onb-modal-medidas.njk" as modalMedidas -%}
    ...
    {{ modalMedidas.render() }}
    ...
    <style>
      {{ modalMedidas.styles() | safe }}
    </style>
#}

{% set medidas = [
  { num: 1, nombre: "Cintura", img: "cintura", alt: "Silueta femenina con cinta métrica en la cintura", desc: "A la altura del <strong>ombligo</strong>, ni muy apretada ni muy suelta. Respira normal y relaja el abdomen." },
  { num: 2, nombre: "Cadera", img: "cadera", alt: "Silueta femenina con cinta métrica en la cadera", desc: "En la <strong>parte más ancha</strong> de los glúteos. De pie, pies juntos, sin apretar." },
  { num: 3, nombre: "Pecho", img: "pecho", alt: "Silueta femenina con cinta métrica en el pecho", desc: "Por el <strong>punto más ancho</strong>, justo por debajo de las axilas. Brazos relajados a los lados." },
  { num: 4, nombre: "Brazo", img: "brazo", alt: "Silueta femenina con brazo flexionado y cinta métrica en el bíceps", desc: "Contraído, en el <strong>punto más ancho del bíceps</strong>. Usa tu brazo dominante (el que más usas)." },
  { num: 5, nombre: "Pierna", img: "pierna", alt: "Silueta femenina con cinta métrica en el muslo", desc: "En el <strong>punto más ancho del muslo</strong>, de pie y relajada. Usa la pierna dominante." }
] %}

{% macro styles() %}
  .onb-modal-backdrop {
    /* height: 100dvh explícito (no inset: 0) — Android Chrome con URL
       bar visible usa el layout viewport para inset, dejando el modal
       descentrado. 100dvh es el visual viewport real. */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    background: rgba(17, 17, 17, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    /* flex + align-items: flex-start + margin: auto 0 en el modal =
       centrado cuando cabe, scroll interno cuando no. Patrón clásico
       bulletproof; no depende de max-height resolviéndose contra un
       padding-box (lo que fallaba en Android Chrome). */
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding:
      max(20px, env(safe-area-inset-top, 20px))
      16px
      max(20px, env(safe-area-inset-bottom, 20px));
    z-index: 1000;
    animation: onbBackdropFade 0.25s var(--ease-out);
  }
  .onb-modal-backdrop[hidden] { display: none; }
  body:has(.onb-modal-backdrop:not([hidden])) { overflow: hidden; }

  @keyframes onbBackdropFade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .onb-modal {
    position: relative;
    background: var(--color-white);
    border-radius: var(--border-radius-lg);
    max-width: 900px;
    width: 100%;
    /* margin: auto 0 centra el modal en el cross-axis cuando cabe; si
       excede el backdrop, margin auto se resuelve a 0 y el modal empieza
       desde arriba (align-items: flex-start) — el backdrop scrollea. */
    margin: auto 0;
    padding: 40px 36px 32px;
    box-shadow: var(--shadow-elevated);
    animation: onbModalIn 0.3s var(--ease-out);
  }
  @keyframes onbModalIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)    scale(1); }
  }

  .onb-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 0;
    background: var(--color-cream);
    color: var(--color-gray);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    z-index: 2;
  }
  .onb-modal-close:hover {
    background: var(--color-green);
    color: var(--color-white);
    transform: rotate(90deg);
  }

  .onb-modal-header {
    text-align: center;
    margin: 0 auto 28px;
    max-width: 580px;
  }
  .onb-modal-header h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 8px 0 12px;
  }
  .onb-modal-sub {
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .onb-medida-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
  }

  .onb-medida {
    position: relative;
    background: var(--color-cream);
    border-radius: var(--border-radius-card);
    padding: 20px 18px;
    text-align: center;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    border: 1px solid transparent;
  }
  .onb-medida:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(74,124,89,0.08);
    border-color: var(--color-green-muted);
  }
  .onb-medida-num {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-green);
    color: var(--color-white);
    font-size: 0.82rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(74,124,89,0.25);
    z-index: 1;
  }
  .onb-medida-fig {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .onb-medida-fig img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .onb-medida h3 {
    font-size: 1.05rem;
    color: var(--color-green-dark);
    margin-bottom: 6px;
  }
  .onb-medida p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-black);
    margin: 0;
  }
  .onb-medida p strong { color: var(--color-green-dark); }

  .onb-modal-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }
  .onb-modal-tip {
    font-size: 0.88rem;
    color: var(--color-gray);
    text-align: center;
    max-width: 520px;
    margin: 0;
    line-height: 1.55;
  }
  .onb-modal-tip strong { color: var(--color-green-dark); }

  @media (max-width: 640px) {
    .onb-modal-backdrop {
      padding:
        max(12px, env(safe-area-inset-top, 12px))
        12px
        max(12px, env(safe-area-inset-bottom, 12px));
    }
    .onb-modal {
      padding: 48px 18px 20px;
      border-radius: 18px;
    }
    .onb-modal-close { top: 10px; right: 10px; width: 36px; height: 36px; }
    .onb-modal-header { margin: 0 auto 20px; padding-top: 4px; }

    .onb-medida-grid { grid-template-columns: 1fr; gap: 14px; }
    .onb-medida { padding: 18px 14px 20px; }
    .onb-medida-num { top: 10px; left: 10px; width: 26px; height: 26px; font-size: 0.78rem; }
    .onb-medida-fig { max-width: 220px; margin: 6px auto 14px; }
    .onb-medida h3 { margin: 4px 0 6px; font-size: 1.05rem; }
    .onb-medida p { font-size: 0.92rem; line-height: 1.6; }
  }
{% endmacro %}

{% macro render() %}
<div class="onb-modal-backdrop" id="modal-medidas" hidden>
  <div class="onb-modal" role="dialog" aria-modal="true" aria-labelledby="modal-medidas-title">
    <button type="button" class="onb-modal-close" aria-label="Cerrar guía" data-close-modal>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="onb-modal-header">
      <span class="overline">Guía visual</span>
      <h2 id="modal-medidas-title">Cómo tomarte las medidas</h2>
      <p class="onb-modal-sub">Mídete de pie, relajada, en ropa interior o ropa ajustada. Por la mañana en ayunas, mejor. Usa una cinta métrica flexible.</p>
    </div>

    <div class="onb-medida-grid">
      {% for m in medidas %}
      <article class="onb-medida">
        <span class="onb-medida-num" aria-hidden="true">{{ m.num }}</span>
        <div class="onb-medida-fig">
          <picture>
            <source srcset="/img/medidas/medida-{{ m.img }}.webp" type="image/webp">
            <img src="/img/medidas/medida-{{ m.img }}.png" alt="{{ m.alt }}" loading="lazy" width="800" height="436">
          </picture>
        </div>
        <h3>{{ m.nombre }}</h3>
        <p>{{ m.desc | safe }}</p>
      </article>
      {% endfor %}
    </div>

    <div class="onb-modal-foot">
      <button type="button" class="btn btn-primary" data-close-modal>Entendido, volver al formulario</button>
      <p class="onb-modal-tip">💡 Mídete siempre <strong>por la mañana en ayunas</strong> y el <strong>mismo día de la semana</strong>. Así los cambios son comparables.</p>
    </div>
  </div>
</div>
{% endmacro %}
