  <meta charset="UTF-8">
  <meta name="google-site-verification" content="a5hA-WBmBo4Hp1V61UimY41b1McnSKxFXM2HGxGRsP8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#4a7c59">
  <meta name="color-scheme" content="light">
  <meta name="author" content="Cristina Lorente Piquer">
  <title>{{ title }}{% if title %} — {% endif %}Cris Lorente</title>
  <meta name="description" content="{{ description }}">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <!-- Open Graph -->
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title }}{% if title %} — {% endif %}Cris Lorente">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.defaultImage }}">
  <meta property="og:image:secure_url" content="{{ site.url }}{{ ogImage or site.defaultImage }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogImageAlt or title or site.name }}">
  <meta property="og:locale" content="es_ES">
  {% if date %}<meta property="og:updated_time" content="{{ date | fechaISO }}">{% endif %}
  {% if ogType == "article" %}
  <meta property="article:published_time" content="{{ date | fechaISO }}">
  <meta property="article:modified_time" content="{% if dateModified %}{{ dateModified | fechaISO }}{% else %}{{ date | fechaISO }}{% endif %}">
  <meta property="article:author" content="Cristina Lorente Piquer">
  <meta property="article:section" content="{{ categoryLabel }}">
  <meta property="article:publisher" content="https://www.crislorentenutricion.com/">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}{% if title %} — {% endif %}Cris Lorente">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.defaultImage }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="es-ES" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}">
  <meta name="geo.region" content="ES">
  <meta name="geo.placename" content="España">
  <meta name="content-language" content="es">
  <link rel="alternate" type="application/atom+xml" title="Cris Lorente Nutrición — Blog" href="{{ site.url }}/feed.xml">
  <link rel="author" href="/humans.txt">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% if env.amplitudeApiKey %}<link rel="preconnect" href="https://cdn.amplitude.com" crossorigin>
  <link rel="dns-prefetch" href="https://api2.amplitude.com">{% endif %}
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;1,400;1,600&family=Manrope:wght@400;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;1,400;1,600&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet"></noscript>
  <link rel="stylesheet" href="/css/style.css">
  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  {% if not appleTouchIcon %}<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">{% endif %}
  {% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}"{% if preloadImageType %} type="{{ preloadImageType }}"{% endif %} fetchpriority="high">{% endif %}
