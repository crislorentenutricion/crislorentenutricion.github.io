---
layout: layouts/base.njk
title: Blog
seoTitle: "Blog de alimentación sin dietas: recetas y hábitos saludables"
description: Artículos sobre nutrición, recetas saludables y bienestar. Educación, recetas y consejos para cuidarte sin obsesionarte.
navActive: blog
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.crislorentenutricion.com/blog/#blog",
  "name": "Blog — Cris Lorente Nutrición",
  "description": "Artículos sobre nutrición, recetas saludables y bienestar.",
  "url": "https://www.crislorentenutricion.com/blog/",
  "inLanguage": "es-ES",
  "publisher": { "@id": "https://www.crislorentenutricion.com/#organization" },
  "author": { "@id": "https://www.crislorentenutricion.com/sobre-mi/#person" },
  "blogPost": [
    {%- for post in blog | ordenarPorFecha -%}
    {
      "@type": "BlogPosting",
      "headline": "{{ post.title | replace('"', '\\"') }}",
      "url": "https://www.crislorentenutricion.com/blog/{{ post.urlCategory }}/{{ post.slug }}/",
      "datePublished": "{{ post.date | fechaISO }}",
      "image": "https://www.crislorentenutricion.com/img/blog/{{ post.image }}"{% if post.categoryLabel %},
      "articleSection": "{{ post.categoryLabel }}"{% endif %}
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.crislorentenutricion.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog" }
  ]
}
</script>

<section class="hero section-cream">
  <div class="container hero-inner hero-centered">
    <div class="hero-text">
      <h1 class="hero-animate hero-animate-1">Aprende a comer bien con tu vida real</h1>
      <p class="hero-subtitle hero-animate hero-animate-2">Nutrición sin mitos, recetas rápidas y consejos para comer bien con turnos, táper y poco tiempo.</p>
    </div>
  </div>
</section>

<section class="section section-white">
  <div class="container">
    <h2 class="section-title reveal">De qué escribo</h2>
    <div class="categories-grid">
      <div class="category-card card reveal reveal-delay-1" data-filter="organizacion-semana" role="button" tabindex="0" aria-pressed="false">
        <div class="category-icon">{% set iconName = "clipboard-list" %}{% include "icon.njk" %}</div>
        <h3>Organización de la semana</h3>
        <p>Planificación, batch cooking, compra, nevera y congelador para llegar a la semana con las comidas resueltas.</p>
      </div>
      <div class="category-card card reveal reveal-delay-2" data-filter="comer-sin-tiempo" role="button" tabindex="0" aria-pressed="false">
        <div class="category-icon">{% set iconName = "clock" %}{% include "icon.njk" %}</div>
        <h3>Comer bien sin tiempo</h3>
        <p>Turnos, jornada partida, táper y comer fuera de casa sin complicarte.</p>
      </div>
      <div class="category-card card reveal reveal-delay-3" data-filter="suplementos-mitos" role="button" tabindex="0" aria-pressed="false">
        <div class="category-icon">{% set iconName = "brain" %}{% include "icon.njk" %}</div>
        <h3>Suplementos y mitos</h3>
        <p>Lo que se pregunta en la farmacia: qué es verdad, qué no y cómo leer lo que compras.</p>
      </div>
      <div class="category-card card reveal reveal-delay-4" data-filter="recetas" role="button" tabindex="0" aria-pressed="false">
        <div class="category-icon">{% set iconName = "chef-hat" %}{% include "icon.njk" %}</div>
        <h3>Recetas</h3>
        <p>Platos sencillos para llevar en el táper y comer bien cada día.</p>
      </div>
      <div class="category-card card reveal reveal-delay-4" data-filter="mi-dia-a-dia" role="button" tabindex="0" aria-pressed="false">
        <div class="category-icon">{% set iconName = "heart" %}{% include "icon.njk" %}</div>
        <h3>Mi día a día</h3>
        <p>Mi proceso y mi día a día, contados sin filtros.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-cream">
  <div class="container">
    <h2 class="section-title" id="articles-title">Todos los artículos</h2>
    <div class="blog-grid">
      {% for post in blog | ordenarPorFecha %}
        {% include "blog-card.njk" %}
      {% endfor %}
    </div>
    <div class="blog-more-wrap" id="blog-more-wrap" hidden>
      <button class="btn btn-secondary" id="btn-ver-mas">Ver más artículos</button>
    </div>
  </div>
</section>

<script>
  const categoryNames = {
    'organizacion-semana': 'Organización de la semana',
    'comer-sin-tiempo': 'Comer bien sin tiempo',
    'suplementos-mitos': 'Suplementos y mitos',
    'recetas': 'Recetas',
    'mi-dia-a-dia': 'Mi día a día'
  };
  const ROW_SIZE = 3;
  const moreWrap = document.getElementById('blog-more-wrap');
  const btnVerMas = document.getElementById('btn-ver-mas');

  function applyFilter(filter) {
    const allCards = Array.from(document.querySelectorAll('.blog-card-link'));
    const matching = filter === 'all'
      ? allCards
      : allCards.filter(a => a.dataset.category === filter);
    const rest = filter === 'all'
      ? []
      : allCards.filter(a => a.dataset.category !== filter);

    rest.forEach(a => a.style.display = 'none');
    matching.forEach((a, i) => {
      a.style.display = i < ROW_SIZE ? '' : 'none';
    });

    if (matching.length > ROW_SIZE) {
      const hidden = matching.length - ROW_SIZE;
      btnVerMas.textContent = `Ver ${hidden} artículo${hidden > 1 ? 's' : ''} más`;
      moreWrap.hidden = false;
      btnVerMas.onclick = () => {
        matching.forEach(a => a.style.display = '');
        moreWrap.hidden = true;
      };
    } else {
      moreWrap.hidden = true;
    }
  }

  applyFilter('all');

  document.querySelectorAll('.category-card[data-filter]').forEach(card => {
    function toggleFilter() {
      const filter = card.dataset.filter;
      const isActive = card.classList.contains('active');
      const title = document.getElementById('articles-title');

      document.querySelectorAll('.category-card[data-filter]').forEach(c => {
        c.classList.remove('active');
        c.setAttribute('aria-pressed', 'false');
      });

      if (isActive) {
        title.textContent = 'Todos los artículos';
        applyFilter('all');
      } else {
        card.classList.add('active');
        card.setAttribute('aria-pressed', 'true');
        title.textContent = categoryNames[filter];
        applyFilter(filter);
      }
    }

    card.addEventListener('click', toggleFilter);
    card.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleFilter(); } });
  });
</script>
