<h1>Pacientes</h1>
<div id="tabla-pacientes"></div>
<div id="estado-auth" class="bo-estado" role="status" aria-live="polite"></div>

<script src="/backoffice/backoffice-pacientes.js"></script>
<script>
  // Auth → BoPacientes.arrancar(supa). El filtro (Activas/Cerradas/Todas) se
  // gestiona dentro de BoPacientes; por defecto muestra Activas.
  // DOMContentLoaded espera a que auth.js (cargado al final del layout) exista.
  document.addEventListener('DOMContentLoaded', function () {
    window.BoAuth.iniciar({
      onListo: function (supa) {
        window.BoPacientes.arrancar(supa);
      }
    });
  });
</script>
