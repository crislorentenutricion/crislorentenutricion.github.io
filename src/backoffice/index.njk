<h1>Hoy</h1>
<div id="bloques"></div>
<div id="estado-auth" class="bo-estado" role="status" aria-live="polite"></div>

<script src="/backoffice/backoffice-hoy.js"></script>
<script>
  // Orquestación: auth → BoHoy.arrancar(supa). Si RLS deniega o el SDK falla,
  // BoHoy.arrancar muestra el error en #estado-auth sin romper la página.
  window.BoAuth.iniciar({
    onListo: function (supa) {
      window.BoHoy.arrancar(supa);
    }
  });
</script>
