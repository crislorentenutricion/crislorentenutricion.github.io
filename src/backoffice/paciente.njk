<div id="estado-paciente" class="bo-estado" role="status" aria-live="polite"></div>
<div id="cabecera"></div>

<div id="tabs" class="bo-tabs" role="tablist" aria-label="Secciones del paciente">
  <button id="tab-anamnesis"  type="button" role="tab" data-bo-tab="anamnesis"  aria-controls="panel-anamnesis"  aria-selected="false" tabindex="-1">Anamnesis</button>
  <button id="tab-evolucion"  type="button" role="tab" data-bo-tab="evolucion"  aria-controls="panel-evolucion"  aria-selected="false" tabindex="-1">Evolución</button>
  <button id="tab-adherencia" type="button" role="tab" data-bo-tab="adherencia" aria-controls="panel-adherencia" aria-selected="false" tabindex="-1">Adherencia</button>
  <button id="tab-pagos"      type="button" role="tab" data-bo-tab="pagos"      aria-controls="panel-pagos"      aria-selected="false" tabindex="-1">Pagos</button>
  <button id="tab-timeline"   type="button" role="tab" data-bo-tab="timeline"   aria-controls="panel-timeline"   aria-selected="false" tabindex="-1">Timeline</button>
</div>

<div id="panel-anamnesis"  role="tabpanel" data-bo-panel="anamnesis"  aria-labelledby="tab-anamnesis"  hidden></div>
<div id="panel-evolucion"  role="tabpanel" data-bo-panel="evolucion"  aria-labelledby="tab-evolucion"  hidden></div>
<div id="panel-adherencia" role="tabpanel" data-bo-panel="adherencia" aria-labelledby="tab-adherencia" hidden></div>
<div id="panel-pagos"      role="tabpanel" data-bo-panel="pagos"      aria-labelledby="tab-pagos"      hidden></div>
<div id="panel-timeline"   role="tabpanel" data-bo-panel="timeline"   aria-labelledby="tab-timeline"   hidden></div>

<div id="acciones"></div>

<script src="/backoffice/backoffice-paciente.js"></script>
<script>
  // Orquestación: leer ?id= de la URL, pedir auth, y pasar el id a BoPaciente.
  // Si no hay id, mostramos un mensaje amable con link a la lista — sin romper.
  // DOMContentLoaded espera a que auth.js (cargado al final del layout) exista.
  document.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(window.location.search);
    var id = (params.get('id') || '').trim();
    if (!id) {
      var est = document.getElementById('estado-paciente');
      if (est) {
        est.className = 'bo-estado is-error';
        est.innerHTML = 'Falta el identificador del paciente en la URL. ' +
          '<a class="bo-fila-link" href="/backoffice/pacientes/">Volver a Pacientes</a>.';
      }
      return;
    }
    window.BoAuth.iniciar({
      onListo: function (supa, session) {
        window.BoPaciente.arrancar(supa, id);
      }
    });
  });
</script>
