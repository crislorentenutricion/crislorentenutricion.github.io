        <div class="onb-field">
          <label for="f-dia-normal">Descríbeme un día normal de comidas</label>
          <textarea id="f-dia-normal" name="dia_normal" rows="5" placeholder="Desayuno: café con leche + tostadas. Media mañana: fruta. Comida: ensalada con pollo. Merienda: yogur. Cena: pescado con verdura. Lo que comes de verdad, no lo que deberías."></textarea>
        </div>

        <div class="onb-actions">
          <button type="button" class="btn btn-secondary" data-prev="3">← Atrás</button>
          <button type="button" class="btn btn-primary" data-next="5">Continuar →</button>
        </div>
      </div>

      <!-- ============================================
           PASO 5 — GUSTOS Y PREFERENCIAS
           ============================================ -->
      <div class="onb-step" data-step="5" data-title="Gustos">
        <span class="overline">Paso 5 de 7</span>
        <h2>Gustos y preferencias</h2>
        <p class="onb-subtitle">Tómate un minuto en las categorías que te suenen — es para que no te ponga cosas que odias y aproveche las que te encantan. No hace falta marcar todo.</p>

        <!-- Bloque 1: NO me gusta -->
        <div class="onb-foods-block onb-foods-no">
          <div class="onb-foods-head">
            <span class="onb-foods-icon" aria-hidden="true">✕</span>
            <div>
              <h3 class="onb-foods-title">Lo que <strong>NO</strong> te gusta o evitas</h3>
              <p class="onb-foods-sub">Despliega las categorías donde haya cosas que rechazas.</p>
            </div>
          </div>

          {% for cat in categoriasAlimentos %}
          <details class="onb-cat" data-group="no" data-cat="{{ cat.id }}">
            <summary class="onb-cat-summary">
              <span class="onb-cat-name">{{ cat.nombre }}</span>
              <span class="onb-cat-count" data-count="no-{{ cat.id }}" aria-label="alimentos marcados"></span>
              <span class="onb-cat-chevron" aria-hidden="true">▾</span>
            </summary>
            <div class="onb-chips">
              {% for item in cat.items %}
              <label class="onb-chip">
                <input type="checkbox" name="no_gustan" value="{{ cat.id }}:{{ item }}">
                <span>{{ item }}</span>
              </label>
              {% endfor %}
            </div>
          </details>
          {% endfor %}

          <div class="onb-field onb-foods-extra">
            <label for="f-no-gustan-otros">¿Algo más que no haya listado?</label>
            <textarea id="f-no-gustan-otros" name="no_gustan_otros" rows="2" placeholder="Ej: cilantro, olivas, hígado, queso azul..."></textarea>
          </div>
        </div>

        <!-- Bloque 2: SÍ me gusta -->
        <div class="onb-foods-block onb-foods-si">
          <div class="onb-foods-head">
            <span class="onb-foods-icon" aria-hidden="true">♥</span>
            <div>
              <h3 class="onb-foods-title">Lo que <strong>SÍ</strong> te gusta mucho</h3>
              <p class="onb-foods-sub">Cuéntame tus platos o comidas favoritas — los que te hacen feliz o pedirías siempre.</p>
            </div>
          </div>

          <div class="onb-field onb-foods-extra">
            <label for="f-gustan" class="visually-hidden">Platos o comidas que te encantan</label>
            <textarea id="f-gustan" name="gustan" rows="5" placeholder="Ej: la paella de los domingos, el hummus casero con zanahoria, un buen sushi, la tortilla de patatas bien jugosa, la ensalada con mango y pollo..."></textarea>
          </div>
        </div>

        <div class="onb-actions">
          <button type="button" class="btn btn-secondary" data-prev="4">← Atrás</button>
          <button type="button" class="btn btn-primary" data-next="6">Continuar →</button>
        </div>
      </div>

      <!-- ============================================
           PASO 6 — ACTIVIDAD Y BIENESTAR
           ============================================ -->
      <div class="onb-step" data-step="6" data-title="Actividad y bienestar">
        <span class="overline">Paso 6 de 7</span>
        <h2>Actividad física y bienestar</h2>
        <p class="onb-subtitle">Energía, sueño y estrés influyen tanto como la comida. Cuéntame cómo estás.</p>

        <div class="onb-field">
          <label>Nivel de actividad física general</label>
          <div class="onb-radios">
            <label class="onb-radio"><input type="radio" name="nivel_actividad" value="sedentario"><span>Sedentario (trabajo sentada, apenas camino)</span></label>
            <label class="onb-radio"><input type="radio" name="nivel_actividad" value="ligero"><span>Ligero (camino algo, ejercicio 1-2 días)</span></label>
            <label class="onb-radio"><input type="radio" name="nivel_actividad" value="moderado"><span>Moderado (entreno 3-4 días / semana)</span></label>
            <label class="onb-radio"><input type="radio" name="nivel_actividad" value="activo"><span>Activo (entreno 5+ días / semana)</span></label>
            <label class="onb-radio"><input type="radio" name="nivel_actividad" value="muy_activo"><span>Muy activo (deportista o trabajo físico)</span></label>
          </div>
        </div>

        <div class="onb-field">
          <label for="f-ejercicio">Si haces ejercicio, cuéntame qué tipo, cuántos días y cuánto dura cada sesión</label>
          <textarea id="f-ejercicio" name="ejercicio" rows="3" placeholder="Ej: Pilates 2 días (1h) + caminar 30 min diarios. O gimnasio 4 días, 1h pesas + 20 min cardio."></textarea>
        </div>

        <div class="onb-field">
          <label>¿Cómo es tu calidad de sueño?</label>
          <div class="onb-radios">
            <label class="onb-radio"><input type="radio" name="sueno" value="mala"><span>Mala</span></label>
            <label class="onb-radio"><input type="radio" name="sueno" value="regular"><span>Regular</span></label>
            <label class="onb-radio"><input type="radio" name="sueno" value="buena"><span>Buena</span></label>
            <label class="onb-radio"><input type="radio" name="sueno" value="excelente"><span>Excelente</span></label>
          </div>
        </div>

        <div class="onb-field">
          <label>¿El estrés o las emociones influyen en tu manera de comer?</label>
          <div class="onb-radios">
            <label class="onb-radio"><input type="radio" name="estres_come" value="nada"><span>Nada o casi nada</span></label>
            <label class="onb-radio"><input type="radio" name="estres_come" value="a_veces"><span>A veces</span></label>
            <label class="onb-radio"><input type="radio" name="estres_come" value="bastante"><span>Bastante</span></label>
            <label class="onb-radio"><input type="radio" name="estres_come" value="mucho"><span>Mucho — como por ansiedad o evito comer</span></label>
          </div>
        </div>

        <div class="onb-field">
          <label for="f-notas">¿Algo más que creas importante que sepa sobre ti?</label>
          <textarea id="f-notas" name="notas_extra" rows="3" placeholder="Cualquier cosa que no haya preguntado y sientas que debería saber."></textarea>
        </div>

        <div class="onb-actions">
          <button type="button" class="btn btn-secondary" data-prev="5">← Atrás</button>
          <button type="button" class="btn btn-primary" data-next="7">Continuar →</button>
        </div>
      </div>

      <!-- ============================================
           PASO 7 — CONSENTIMIENTO Y ENVÍO
           ============================================ -->
      <div class="onb-step" data-step="7" data-title="Casi listo">
        <span class="overline">Paso 7 de 7</span>
        <h2>Ya está, solo falta tu consentimiento</h2>
        <p class="onb-subtitle">Revisa que todo sea correcto y acepta el tratamiento de datos para que pueda trabajar con tu información.</p>

        <div class="onb-consent">
          <label class="onb-check-item onb-check-consent">
            <input type="checkbox" id="f-consent" name="consentimiento" required>
            <span>
              He leído y acepto la <a href="/legal/privacidad/" target="_blank">Política de privacidad</a> y las <a href="/legal/condiciones/" target="_blank">Condiciones del servicio</a> de CLN. Confirmo que los datos son verídicos y consiento el tratamiento de mis datos personales y de salud para la prestación del servicio de asesoría nutricional personalizada. <span class="req">*</span>
            </span>
          </label>
        </div>

        <div class="onb-reassure">
          <p><strong>¿Qué pasará después?</strong></p>
          <ol>
            <li>Recibo tus datos y los reviso personalmente.</li>
            <li>En las próximas <strong>48 horas</strong> preparo tu menú mensual personalizado.</li>
            <li>Te aviso por email en cuanto esté listo — y lo verás también en tu zona privada <strong>Mi Seguimiento</strong>.</li>
          </ol>
        </div>

        <div class="onb-actions">
          <button type="button" class="btn btn-secondary" data-prev="6">← Atrás</button>
          <button type="submit" class="btn btn-primary btn-lg">Enviar mis datos ✓</button>
        </div>
      </div>

      <!-- ============================================
           PASO 8 — GRACIAS
           ============================================ -->
      <div class="onb-step" data-step="8">
        <div class="onb-thanks">
          <div class="onb-thanks-icon">✓</div>
          <h1>¡Gracias, <span id="onb-thanks-name">tú</span>!</h1>
          <p class="onb-thanks-text">
            He recibido tu información. En las próximas <strong>48 horas</strong> tendrás tu menú mensual personalizado listo. Te aviso por email en cuanto esté disponible y lo verás automáticamente en tu zona privada <strong>Mi Seguimiento</strong>.
          </p>
          <div class="onb-thanks-cards">
            <a href="/mi-seguimiento/" class="btn btn-primary btn-lg">Ir a Mi Seguimiento</a>
            <a href="/" class="btn btn-secondary">Volver al inicio</a>
          </div>
          <p class="onb-thanks-foot">Mientras esperas, puedes echarle un ojo al <a href="/blog/">blog</a> o seguirme en <a href="https://instagram.com/crislorente_nutricion" target="_blank" rel="noopener">@crislorente_nutricion</a>.</p>
        </div>
      </div>

    </form>

    <!-- ============================================
         MODAL: Guía visual de medidas
         ============================================ -->
    <div class="onb-modal-backdrop" id="modal-medidas" hidden>
      <div class="onb-modal" role="dialog" aria-modal="true" aria-labelledby="modal-medidas-title">
        <button type="button" class="onb-modal-close" aria-label="Cerrar guía" data-close-modal>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <div class="onb-modal-header">
          <span class="overline">Guía visual</span>
          <h2 id="modal-medidas-title">Cómo tomarte las medidas</h2>
          <p class="onb-modal-sub">Mídete de pie, relajada, en ropa interior o ropa ajustada. Por la mañana en ayunas, mejor. Usa una cinta métrica flexible.</p>
        </div>

        <div class="onb-medida-grid">
          <!-- CINTURA -->
          <article class="onb-medida">
            <div class="onb-medida-fig">
              <img src="/img/medidas/medida-cintura.png" alt="Silueta femenina con cinta métrica en la cintura" loading="lazy" width="600" height="343">
            </div>
            <h3>Cintura</h3>
            <p>A la altura del <strong>ombligo</strong>, ni muy apretada ni muy suelta. Respira normal y relaja el abdomen.</p>
          </article>

          <!-- CADERA -->
          <article class="onb-medida">
            <div class="onb-medida-fig">
              <img src="/img/medidas/medida-cadera.png" alt="Silueta femenina con cinta métrica en la cadera" loading="lazy" width="600" height="343">
            </div>
            <h3>Cadera</h3>
            <p>En la <strong>parte más ancha</strong> de los glúteos. De pie, pies juntos, sin apretar.</p>
          </article>

          <!-- PECHO -->
          <article class="onb-medida">
            <div class="onb-medida-fig">
              <img src="/img/medidas/medida-pecho.png" alt="Silueta femenina con cinta métrica en el pecho" loading="lazy" width="600" height="343">
            </div>
            <h3>Pecho</h3>
            <p>Por el <strong>punto más ancho</strong>, justo por debajo de las axilas. Brazos relajados a los lados.</p>
          </article>

          <!-- BRAZO -->
          <article class="onb-medida">
            <div class="onb-medida-fig">
              <img src="/img/medidas/medida-brazo.png" alt="Silueta femenina con brazo flexionado y cinta métrica en el bíceps" loading="lazy" width="600" height="343">
            </div>
            <h3>Brazo</h3>
            <p>Contraído, en el <strong>punto más ancho del bíceps</strong>. Usa tu brazo dominante (el que más usas).</p>
          </article>

          <!-- PIERNA -->
          <article class="onb-medida">
            <div class="onb-medida-fig">
              <img src="/img/medidas/medida-pierna.png" alt="Silueta femenina con cinta métrica en el muslo" loading="lazy" width="600" height="343">
            </div>
            <h3>Pierna</h3>
            <p>En el <strong>punto más ancho del muslo</strong>, de pie y relajada. Usa la pierna dominante.</p>
          </article>
        </div>

        <div class="onb-modal-foot">
          <button type="button" class="btn btn-primary" data-close-modal>Entendido, volver al formulario</button>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ======================================================
     ONBOARDING — prototipo visual del formulario anamnesis
     Prefijo .onb-* para no colisionar con el resto del CSS
     ====================================================== */

  .onb {
    background: var(--color-cream);
    padding: 48px 0 96px;
    min-height: calc(100vh - 200px);
  }
  .onb-container {
    max-width: 720px;
    margin: 0 auto;
    padding-left: max(var(--container-padding), env(safe-area-inset-left));
    padding-right: max(var(--container-padding), env(safe-area-inset-right));
  }

  /* Progress bar */
  .onb-progress {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-cream);
    padding: 16px 0 12px;
    margin-bottom: 24px;
  }
  .onb-progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--color-gray);
    margin-bottom: 8px;
  }
  .onb-progress-meta strong { color: var(--color-green-dark); }
  .onb-progress-meta span:last-child {
    color: var(--color-green-dark);
    font-weight: var(--font-weight-semibold);
  }
  .onb-progress-track {
    height: 6px;
    background: var(--color-green-muted);
    border-radius: 100px;
    overflow: hidden;
  }
  .onb-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-green) 0%, #6ba37a 100%);
    border-radius: 100px;
    width: 0%;
    transition: width 0.4s var(--ease-out);
  }

  /* Steps */
  .onb-step {
    display: none;
    background: var(--color-white);
    border-radius: var(--border-radius-lg);
    padding: 48px 40px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border);
    animation: onbFadeIn 0.4s var(--ease-out);
  }
  .onb-step.is-active { display: block; }

  @keyframes onbFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .onb-step h1, .onb-step h2 {
    margin-top: 12px;
    margin-bottom: 12px;
  }
  .onb-step h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .onb-step h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); }
  .onb-subtitle {
    color: var(--color-gray);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  /* Welcome */
  .onb-welcome { text-align: center; padding: 16px 0; }
  .onb-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 20px;
    border: 3px solid var(--color-green-muted);
    display: block;
  }
  .onb-welcome-text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-gray);
    max-width: 520px;
    margin: 0 auto 28px;
  }
  .onb-welcome-list {
    text-align: left;
    max-width: 440px;
    margin: 0 auto 36px;
    list-style: none;
    padding: 0;
  }
  .onb-welcome-list li {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    gap: 12px;
    align-items: flex-start;
    line-height: 1.6;
  }
  .onb-welcome-list li:last-child { border-bottom: 0; }
  .onb-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px; height: 24px;
    background: var(--color-green-muted);
    color: var(--color-green-dark);
    border-radius: 50%;
    font-weight: bold;
    flex-shrink: 0;
    font-size: 0.85rem;
  }
  .onb-welcome-foot {
    margin-top: 24px;
    color: var(--color-gray);
    font-size: 0.9rem;
  }

  /* Fieldsets */
  .onb-fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 32px 0;
  }
  .onb-legend {
    font-weight: var(--font-weight-bold);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-green);
    margin-bottom: 16px;
    display: block;
    padding: 0;
  }
  .onb-optional {
    color: var(--color-gray);
    font-weight: var(--font-weight-regular);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.75rem;
  }

  /* Fields */
  .onb-field {
    margin-bottom: 20px;
  }
  .onb-field label {
    display: block;
    font-weight: var(--font-weight-semibold);
    color: var(--color-black);
    margin-bottom: 8px;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .onb-field label .req {
    color: #c0392b;
    font-weight: var(--font-weight-regular);
  }
  .onb-muted {
    color: var(--color-gray);
    font-weight: var(--font-weight-regular);
    font-size: 0.85rem;
  }
  .onb-field input[type="text"],
  .onb-field input[type="email"],
  .onb-field input[type="tel"],
  .onb-field input[type="number"],
  .onb-field input[type="date"],
  .onb-field select,
  .onb-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-family);
    font-size: 1rem;
    background: var(--color-white);
    color: var(--color-black);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .onb-field input:focus,
  .onb-field select:focus,
  .onb-field textarea:focus {
    outline: 0;
    border-color: var(--color-green);
    box-shadow: 0 0 0 3px var(--color-green-tint);
  }
  .onb-field textarea {
    resize: vertical;
    min-height: 80px;
    line-height: 1.6;
  }
  .onb-hint {
    display: block;
    color: var(--color-gray);
    font-size: 0.82rem;
    margin-top: 6px;
    line-height: 1.5;
    font-weight: var(--font-weight-regular);
  }
  .onb-hint-box {
    background: var(--color-green-light);
    border-left: 3px solid var(--color-green);
    padding: 12px 14px;
    border-radius: var(--border-radius-sm);
    margin-bottom: 20px;
    color: var(--color-black);
    font-size: 0.9rem;
  }
  .onb-hint-box strong { color: var(--color-green-dark); }

  /* Grid 2 columns */
  .onb-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  /* Field-level error */
  .onb-field.has-error input,
  .onb-field.has-error select,
  .onb-field.has-error textarea {
    border-color: #c0392b;
    background: #fdf2f2;
  }
  .onb-field.has-error::after {
    content: attr(data-error);
    display: block;
    color: #c0392b;
    font-size: 0.82rem;
    margin-top: 6px;
  }

  /* Radios and checkboxes */
  .onb-radios,
  .onb-checks {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }
  .onb-radio,
  .onb-check-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast);
    font-size: 0.95rem;
    background: var(--color-white);
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
    margin-bottom: 0;
  }
  .onb-radio:hover,
  .onb-check-item:hover {
    border-color: var(--color-green);
    background: var(--color-green-light);
  }
  .onb-radio input,
  .onb-check-item input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin: 0 6px 0 0;
    accent-color: var(--color-green);
    cursor: pointer;
  }
  .onb-radio span,
  .onb-check-item span {
    flex: 1;
  }
  .onb-radio input:checked ~ span,
  .onb-check-item input:checked ~ span {
    font-weight: var(--font-weight-semibold);
    color: var(--color-green-dark);
  }
  .onb-radio:has(input:checked),
  .onb-check-item:has(input:checked) {
    border-color: var(--color-green);
    background: var(--color-green-light);
  }

  /* Consent */
  .onb-consent {
    background: var(--color-green-light);
    border: 1.5px solid var(--color-green-muted);
    border-radius: var(--border-radius-card);
    padding: 20px;
    margin-bottom: 28px;
  }
  .onb-check-consent {
    align-items: flex-start;
    border: 0;
    padding: 0;
    background: transparent;
  }
  .onb-check-consent:hover {
    background: transparent;
    border: 0;
  }
  .onb-check-consent span {
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .onb-check-consent input {
    margin-top: 3px;
  }

  .onb-reassure {
    background: var(--color-cream-dark);
    border-radius: var(--border-radius-card);
    padding: 24px;
    margin-bottom: 28px;
  }
  .onb-reassure p {
    margin-bottom: 12px;
    color: var(--color-green-dark);
  }
  .onb-reassure ol {
    padding-left: 20px;
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .onb-reassure ol li { margin-bottom: 6px; }

  /* Actions */
  .onb-actions {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .onb-actions .btn { flex: 0 1 auto; }

  /* Thanks */
  .onb-thanks { text-align: center; padding: 24px 0; }
  .onb-thanks-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px; height: 80px;
    background: linear-gradient(135deg, var(--color-green) 0%, #6ba37a 100%);
    color: var(--color-white);
    border-radius: 50%;
    font-size: 2.8rem;
    font-weight: bold;
    margin: 0 auto 24px;
    box-shadow: 0 8px 24px var(--color-green-glow);
  }
  .onb-thanks h1 { margin-bottom: 16px; }
  .onb-thanks-text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-gray);
    max-width: 520px;
    margin: 0 auto 36px;
  }
  .onb-thanks-cards {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .onb-thanks-foot {
    color: var(--color-gray);
    font-size: 0.9rem;
  }

  /* ======================================================
     HINT BOX con botón de guía
     ====================================================== */
  .onb-hint-with-action {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .onb-hint-with-action > div { flex: 1 1 260px; }
  .onb-guide-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 100px;
    border: 1.5px solid var(--color-green);
    background: var(--color-white);
    color: var(--color-green-dark);
    font-family: var(--font-family);
    font-size: 0.88rem;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }
  .onb-guide-btn:hover {
    background: var(--color-green);
    color: var(--color-white);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--color-green-glow);
  }
  .onb-guide-btn svg { flex-shrink: 0; }

  /* ======================================================
     MODAL de guía de medidas
     ====================================================== */
  .onb-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(17, 17, 17, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 16px;
    z-index: 1000;
    overflow-y: auto;
    animation: onbBackdropFade 0.25s var(--ease-out);
  }
  body:has(.onb-modal-backdrop:not([hidden])) { overflow: hidden; }

  @keyframes onbBackdropFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .onb-modal {
    position: relative;
    background: var(--color-white);
    border-radius: var(--border-radius-lg);
    max-width: 900px;
    width: 100%;
    padding: 40px 36px 32px;
    box-shadow: var(--shadow-elevated);
    animation: onbModalIn 0.3s var(--ease-out);
    margin: auto 0;
  }
  @keyframes onbModalIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .onb-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 0;
    background: var(--color-cream);
    color: var(--color-gray);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    z-index: 2;
  }
  .onb-modal-close:hover {
    background: var(--color-green);
    color: var(--color-white);
    transform: rotate(90deg);
  }

  .onb-modal-header {
    text-align: center;
    margin-bottom: 32px;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }
  .onb-modal-header h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
    margin: 8px 0 12px;
  }
  .onb-modal-sub {
    color: var(--color-gray);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .onb-medida-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
  }

  .onb-medida {
    background: var(--color-cream);
    border-radius: var(--border-radius-card);
    padding: 20px 18px;
    text-align: center;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    border: 1px solid transparent;
  }
  .onb-medida:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(74,124,89,0.08);
    border-color: var(--color-green-muted);
  }
  .onb-medida-fig {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    background: var(--color-cream);
    border-radius: 12px;
    overflow: hidden;
  }
  .onb-medida-fig img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .onb-medida h3 {
    font-size: 1.05rem;
    color: var(--color-green-dark);
    margin-bottom: 6px;
  }
  .onb-medida p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-black);
    margin: 0;
  }
  .onb-medida p strong { color: var(--color-green-dark); }

  .onb-modal-foot {
    display: flex;
    justify-content: center;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  /* ======================================================
     FOODS — bloques de alimentos con acordeones y chips
     ====================================================== */
  .onb-foods-block {
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-card);
    padding: 24px 20px 20px;
    margin-bottom: 28px;
  }
  .onb-foods-no { border-left: 4px solid #c76c6c; }
  .onb-foods-si { border-left: 4px solid var(--color-green); }

  .onb-foods-head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .onb-foods-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: 50%;
    font-size: 1.1rem;
    font-weight: bold;
    flex-shrink: 0;
  }
  .onb-foods-no .onb-foods-icon { background: #f8dedc; color: #9a3a3a; }
  .onb-foods-si .onb-foods-icon { background: var(--color-green-muted); color: var(--color-green-dark); }

  .onb-foods-title {
    font-size: 1.1rem;
    margin: 0 0 4px;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-tight);
  }
  .onb-foods-no .onb-foods-title strong { color: #9a3a3a; }
  .onb-foods-si .onb-foods-title strong { color: var(--color-green-dark); }
  .onb-foods-sub {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-gray);
    line-height: 1.5;
  }

  /* Acordeón por categoría */
  .onb-cat {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    margin-bottom: 8px;
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .onb-cat[open] {
    border-color: var(--color-green);
    box-shadow: 0 2px 10px rgba(74,124,89,0.08);
  }
  .onb-cat-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
    font-weight: var(--font-weight-semibold);
    font-size: 0.98rem;
    color: var(--color-black);
    user-select: none;
    transition: background var(--transition-fast);
  }
  .onb-cat-summary::-webkit-details-marker { display: none; }
  .onb-cat-summary:hover { background: var(--color-green-light); }

  .onb-cat-name { flex: 1; }
  .onb-cat-count {
    display: none;
    background: var(--color-green);
    color: var(--color-white);
    padding: 2px 10px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: var(--font-weight-bold);
  }
  .onb-foods-no .onb-cat-count { background: #c76c6c; }
  .onb-cat-count.has-selection { display: inline-block; }

  .onb-cat-chevron {
    color: var(--color-gray);
    font-size: 0.9rem;
    transition: transform var(--transition-fast);
  }
  .onb-cat[open] .onb-cat-chevron { transform: rotate(180deg); color: var(--color-green); }

  /* Chips */
  .onb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 18px 18px;
  }
  .onb-chip {
    cursor: pointer;
    user-select: none;
    margin: 0;
  }
  .onb-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .onb-chip span {
    display: inline-block;
    padding: 8px 16px;
    border: 1.5px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-white);
    color: var(--color-black);
    font-size: 0.9rem;
    transition: all var(--transition-fast);
    line-height: 1.3;
  }
  .onb-chip:hover span {
    border-color: var(--color-green);
    background: var(--color-green-light);
  }
  .onb-foods-no .onb-chip input:checked ~ span {
    background: #c76c6c;
    border-color: #c76c6c;
    color: var(--color-white);
    font-weight: var(--font-weight-semibold);
  }
  .onb-foods-si .onb-chip input:checked ~ span {
    background: var(--color-green);
    border-color: var(--color-green);
    color: var(--color-white);
    font-weight: var(--font-weight-semibold);
  }
  .onb-chip input:focus-visible ~ span {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }

  .onb-foods-extra {
    margin-top: 16px;
    margin-bottom: 0;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .onb { padding: 16px 0 64px; }
    .onb-step { padding: 28px 20px; border-radius: var(--border-radius-card); }
    .onb-grid-2 { grid-template-columns: 1fr; gap: 0; }
    .onb-actions { flex-direction: column-reverse; }
    .onb-actions .btn { width: 100%; }
    .onb-progress { padding: 12px 0 10px; }
    .onb-avatar { width: 96px; height: 96px; }
    .onb-foods-block { padding: 20px 16px 16px; }
    .onb-cat-summary { padding: 12px 14px; font-size: 0.92rem; }
    .onb-chips { padding: 6px 14px 14px; gap: 6px; }
    .onb-chip span { padding: 7px 13px; font-size: 0.85rem; }
    .onb-modal-backdrop { padding: 20px 12px; }
    .onb-modal { padding: 32px 20px 24px; }
    .onb-medida-grid { grid-template-columns: 1fr; gap: 14px; }
    .onb-medida { display: grid; grid-template-columns: 80px 1fr; gap: 14px; text-align: left; align-items: center; }
    .onb-medida-fig img { max-width: 180px; }
    .onb-medida-fig { margin-bottom: 0; }
    .onb-hint-with-action { flex-direction: column; align-items: stretch; }
    .onb-guide-btn { justify-content: center; }
  }
</style>

<script>
  (function() {
    const steps = document.querySelectorAll('.onb-step');
    const progress = document.getElementById('onb-progress');
    const progressFill = document.getElementById('onb-progress-fill');
    const stepCurrent = document.getElementById('onb-step-current');
    const stepTitle = document.getElementById('onb-step-title');
    const form = document.getElementById('onb-form');
    const totalSteps = 7;
    const STORAGE_KEY = 'onb-draft-v1';
    let currentStep = 0;

    function goToStep(n) {
      steps.forEach(function(s) { s.classList.remove('is-active'); });
      const target = document.querySelector('[data-step="' + n + '"]');
      if (!target) return;
      target.classList.add('is-active');
      currentStep = n;
      updateProgress(n);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateProgress(n) {
      if (n === 0 || n > totalSteps) {
        progress.hidden = true;
      } else {
        progress.hidden = false;
        stepCurrent.textContent = String(n);
        const pct = (n / totalSteps) * 100;
        progressFill.style.width = pct + '%';
        const target = document.querySelector('[data-step="' + n + '"]');
        if (target && target.dataset.title) stepTitle.textContent = target.dataset.title;
      }
    }

    function clearErrors(step) {
      step.querySelectorAll('.has-error').forEach(function(f) {
        f.classList.remove('has-error');
        f.removeAttribute('data-error');
      });
    }

    function markError(field, msg) {
      const wrapper = field.closest('.onb-field');
      if (wrapper) {
        wrapper.classList.add('has-error');
        wrapper.setAttribute('data-error', msg);
      }
    }

    function validateStep(n) {
      const step = document.querySelector('[data-step="' + n + '"]');
      if (!step) return true;
      clearErrors(step);
      const required = step.querySelectorAll('[required]');
      let valid = true;
      let firstInvalid = null;
      required.forEach(function(el) {
        if (el.type === 'radio') {
          const group = step.querySelectorAll('input[name="' + el.name + '"]');
          const anyChecked = Array.from(group).some(function(r) { return r.checked; });
          if (!anyChecked) {
            valid = false;
            if (!firstInvalid) firstInvalid = el;
            markError(el, 'Elige una opción.');
          }
          return;
        }
        if (el.type === 'checkbox' && !el.checked) {
          valid = false;
          if (!firstInvalid) firstInvalid = el;
          markError(el, 'Marca esta casilla para continuar.');
          return;
        }
        if (!el.value.trim()) {
          valid = false;
          if (!firstInvalid) firstInvalid = el;
          markError(el, 'Este campo es obligatorio.');
          return;
        }
        if (el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value)) {
          valid = false;
          if (!firstInvalid) firstInvalid = el;
          markError(el, 'Revisa el formato del correo.');
        }
      });
      if (firstInvalid) {
        firstInvalid.closest('.onb-field').scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return valid;
    }

    // Persistencia en localStorage (draft)
    function saveDraft() {
      if (!form) return;
      const data = {};
      const fd = new FormData(form);
      for (const [k, v] of fd.entries()) {
        if (data[k] !== undefined) {
          data[k] = [].concat(data[k], v);
        } else {
          data[k] = v;
        }
      }
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch (e) {}
    }
    function loadDraft() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const data = JSON.parse(raw);
        Object.keys(data).forEach(function(name) {
          const value = data[name];
          const fields = form.querySelectorAll('[name="' + name + '"]');
          if (!fields.length) return;
          if (fields[0].type === 'radio') {
            fields.forEach(function(f) { if (f.value === value) f.checked = true; });
          } else if (fields[0].type === 'checkbox') {
            const arr = Array.isArray(value) ? value : [value];
            fields.forEach(function(f) { if (arr.indexOf(f.value) !== -1) f.checked = true; });
          } else {
            fields[0].value = value;
          }
        });
      } catch (e) {}
    }
    loadDraft();
    if (form) form.addEventListener('input', saveDraft);

    // Bind navigation
    document.querySelectorAll('[data-next]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const to = Number(btn.dataset.next);
        if (validateStep(currentStep)) goToStep(to);
      });
    });
    document.querySelectorAll('[data-prev]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const to = Number(btn.dataset.prev);
        goToStep(to);
      });
    });

    // Submit (solo visual — muestra paso de gracias)
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!validateStep(7)) return;
        // Personaliza nombre en paso de gracias
        const nombreField = form.querySelector('[name="nombre"]');
        const firstName = nombreField && nombreField.value.trim().split(/\s+/)[0] || 'tú';
        const nameSpan = document.getElementById('onb-thanks-name');
        if (nameSpan) nameSpan.textContent = firstName;
        goToStep(8);
        // En el prototipo no limpiamos localStorage — facilita volver a probar
      });
    }

    // Modal: abrir / cerrar guía visual
    function openModal(id) {
      const modal = document.getElementById('modal-' + id);
      if (!modal) return;
      modal.hidden = false;
      const closeBtn = modal.querySelector('.onb-modal-close');
      if (closeBtn) closeBtn.focus();
    }
    function closeModal() {
      document.querySelectorAll('.onb-modal-backdrop').forEach(function(m) { m.hidden = true; });
    }
    document.querySelectorAll('[data-open-modal]').forEach(function(btn) {
      btn.addEventListener('click', function() { openModal(btn.dataset.openModal); });
    });
    document.querySelectorAll('[data-close-modal]').forEach(function(btn) {
      btn.addEventListener('click', closeModal);
    });
    document.querySelectorAll('.onb-modal-backdrop').forEach(function(bd) {
      bd.addEventListener('click', function(e) {
        if (e.target === bd) closeModal();
      });
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeModal();
    });

    // Contador de chips marcados por categoría
    function updateFoodCounters() {
      document.querySelectorAll('.onb-cat').forEach(function(cat) {
        const checked = cat.querySelectorAll('.onb-chip input:checked').length;
        const badge = cat.querySelector('.onb-cat-count');
        if (!badge) return;
        if (checked > 0) {
          badge.textContent = String(checked);
          badge.classList.add('has-selection');
        } else {
          badge.textContent = '';
          badge.classList.remove('has-selection');
        }
      });
    }
    document.querySelectorAll('.onb-cat .onb-chip input').forEach(function(chip) {
      chip.addEventListener('change', updateFoodCounters);
    });
    updateFoodCounters();

    // Arranca en el paso 0 (bienvenida)
    goToStep(0);
  })();
</script>
