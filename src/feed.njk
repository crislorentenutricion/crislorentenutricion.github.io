---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
{%- set posts = (blog | ordenarPorFecha) -%}
{%- set latest = posts[0] -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="es">
  <title>Cris Lorente Nutrición — Blog</title>
  <subtitle>Acompañamiento online en hábitos alimentarios. Artículos sobre alimentación real, salud hormonal y hábitos sostenibles.</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ latest.date | fechaISO }}T00:00:00Z</updated>
  <id>{{ site.url }}/</id>
  <rights>© Cristina Lorente Piquer — Cris Lorente Nutrición</rights>
  <generator uri="https://www.11ty.dev/" version="3.1.2">Eleventy</generator>
  <icon>{{ site.url }}/favicon-32x32.png</icon>
  <logo>{{ site.url }}/apple-touch-icon.png</logo>
  <author>
    <name>Cristina Lorente Piquer</name>
    <email>cristina@crislorentenutricion.com</email>
    <uri>{{ site.url }}/sobre-mi/</uri>
  </author>
  {%- for post in posts %}
  <entry>
    <title>{{ post.title }}</title>
    <link href="{{ site.url }}/blog/{{ post.category }}/{{ post.slug }}/"/>
    <updated>{{ post.date | fechaISO }}T00:00:00Z</updated>
    <published>{{ post.date | fechaISO }}T00:00:00Z</published>
    <id>{{ site.url }}/blog/{{ post.category }}/{{ post.slug }}/</id>
    <category term="{{ post.category }}" label="{{ post.categoryLabel }}"/>
    <summary>{{ post.description }}</summary>
  </entry>
  {%- endfor %}
</feed>
