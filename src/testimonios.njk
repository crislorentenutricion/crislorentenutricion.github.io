---
layout: layouts/base.njk
title: "Testimonios — Lo que dicen mis pacientes | Cris Lorente Nutrición"
description: "Reseñas reales de pacientes de Cris Lorente Nutrición. 5 estrellas en Google. Asesoría nutricional personalizada online sin dietas estrictas."
navActive: testimonios
permalink: /testimonios/
---
{% from "testimonials.njk" import testimonialsGrid %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.crislorentenutricion.com/testimonios/#webpage",
  "url": "https://www.crislorentenutricion.com/testimonios/",
  "name": "Testimonios — Lo que dicen mis pacientes",
  "description": "Reseñas reales de pacientes de Cris Lorente Nutrición.",
  "inLanguage": "es-ES",
  "isPartOf": { "@id": "https://www.crislorentenutricion.com/#website" },
  "about": { "@id": "https://www.crislorentenutricion.com/#organization" }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.crislorentenutricion.com/#organization",
  "name": "Cris Lorente Nutrición",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ reviews.aggregateRating.ratingValue }}",
    "reviewCount": "{{ reviews.aggregateRating.reviewCount }}",
    "bestRating": "{{ reviews.aggregateRating.bestRating }}",
    "worstRating": "{{ reviews.aggregateRating.worstRating }}"
  },
  "review": [{% for r in reviews.reviews %}
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": {{ r.name | dump | safe }} },
      "datePublished": "{{ r.datePublished }}",
      "reviewRating": { "@type": "Rating", "ratingValue": "{{ r.rating }}", "bestRating": "5" },
      "reviewBody": {{ r.reviewBody | dump | safe }},
      "itemReviewed": { "@id": "https://www.crislorentenutricion.com/#organization" }
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.crislorentenutricion.com/" },
    { "@type": "ListItem", "position": 2, "name": "Testimonios" }
  ]
}
</script>

{# ── HERO ── #}
<section class="hero section-cream">
  <div class="container hero-inner hero-centered">
    <div class="hero-text">
      <div class="hero-animate hero-animate-1" style="font-size:2rem; margin-bottom: 12px;" role="img" aria-label="5 de 5 estrellas">★★★★★</div>
      <h1 class="hero-animate hero-animate-2">Lo que dicen mis pacientes</h1>
      <p class="hero-subtitle hero-animate hero-animate-3">Resultados reales de personas reales. Sin filtros, sin inventar nada.</p>
    </div>
  </div>
</section>

{# ── RESEÑAS ── #}
<section class="section section-white">
  <div class="container">
    {{ testimonialsGrid(reviews.reviews, reviews.googleProfileUrl) }}

    <p class="testimonials-note reveal">Reseñas verificadas de Google · <a href="{{ reviews.googleProfileUrl }}" target="_blank" rel="noopener">Ver todas en Google&nbsp;→</a></p>
  </div>
</section>

{# ── CTA ── #}
{% include "cta-valoracion.njk" %}
