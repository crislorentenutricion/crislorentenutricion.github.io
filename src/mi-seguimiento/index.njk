---
layout: layouts/app.njk
title: "Mi seguimiento"
description: "Espacio privado de seguimiento nutricional."
permalink: /mi-seguimiento/
eleventyExcludeFromCollections: true
manifest: /mi-seguimiento/manifest.webmanifest
appleTouchIcon: /img/mi-seguimiento/apple-touch-180.png
appleTitle: "Mi seguimiento"
---

<style>
  /* ============================================================
     /mi-seguimiento — editorial-matutino
     Espacio íntimo tipo diario de mañana. Sin header ni footer.
     Reusa tokens del sitio (Manrope + Lora + verde bosque + crema)
     y añade una paleta cálida sólo para esta página.
     ============================================================ */

  .ms-body {
    background:
      radial-gradient(1100px 500px at 50% -180px, #f3eddc 0%, transparent 60%),
      var(--color-cream);
    color: #2d2a24;
  }

  .ms-page {
    max-width: 560px;
    margin: 0 auto;
    padding: 36px 22px 72px;
    position: relative;
  }

  .ms-brand {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.85rem;
    color: #8a8678;
    text-align: center;
    letter-spacing: 0.04em;
    margin-bottom: 18px;
  }
  .ms-brand a { color: inherit; }
  .ms-brand a:hover { color: var(--color-green); text-decoration: none; }

  /* ---------- decorative sprig ---------- */
  .ms-sprig {
    width: 58px; height: 58px;
    margin: 12px auto 28px;
    display: block;
    color: var(--color-green);
    opacity: 0.8;
  }

  /* ============================================================
     LOADING VIEW (boot)
     ============================================================ */
  .ms-loading {
    padding-top: 18vh;
    text-align: center;
  }
  .ms-loading p {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 1rem;
    color: #8a8678;
    margin: 0;
  }

  /* ============================================================
     LOGIN VIEW
     ============================================================ */
  .ms-login { padding-top: 4vh; }
  .ms-login-title {
    font-family: 'Lora', serif;
    font-weight: 400;
    font-size: clamp(1.85rem, 6.2vw, 2.55rem);
    line-height: 1.12;
    letter-spacing: -0.012em;
    text-align: center;
    margin-bottom: 18px;
    color: #2d2a24;
  }
  .ms-login-title em {
    font-style: italic;
    font-weight: 600;
    color: var(--color-green);
  }
  .ms-login-intro {
    font-size: 1rem;
    color: #55524a;
    max-width: 430px;
    margin: 0 auto 44px;
    line-height: 1.65;
    text-align: center;
  }
  .ms-login-form {
    max-width: 380px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ms-login-form[hidden] { display: none; }
  .ms-label {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.95rem;
    color: #6b6759;
    margin-left: 6px;
  }
  .ms-input {
    font-family: var(--font-family);
    font-size: 1rem;
    padding: 15px 18px;
    border: 1px solid #d9d3c3;
    border-radius: 14px;
    background: #fffefa;
    color: #2d2a24;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .ms-input::placeholder { color: #a8a394; }
  .ms-input:focus {
    border-color: var(--color-green);
    box-shadow: 0 0 0 3px rgba(74, 124, 89, 0.12);
  }
  .ms-submit {
    margin-top: 6px;
    padding: 15px 22px;
    background: var(--color-green);
    color: #fff;
    border: 0;
    border-radius: 14px;
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
  }
  .ms-submit:hover { background: var(--color-green-dark); }
  .ms-submit:active { transform: translateY(1px); }
  .ms-submit[disabled] { opacity: 0.6; cursor: progress; }

  .ms-status {
    margin-top: 22px;
    text-align: center;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.95rem;
    color: #55524a;
    line-height: 1.55;
    padding: 0 12px;
  }
  .ms-status.is-ok    { color: var(--color-green-dark); }
  .ms-status.is-error { color: #a14d3a; }

  .ms-consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 2px 6px 4px;
    font-family: 'Lora', serif;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #6b6759;
    cursor: pointer;
  }
  .ms-consent-box {
    flex: 0 0 auto;
    margin-top: 3px;
    width: 16px;
    height: 16px;
    accent-color: var(--color-green);
    cursor: pointer;
  }
  .ms-consent a {
    color: var(--color-green);
    text-decoration: underline;
  }

  .ms-login-hint {
    margin: 4px 6px 0;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.85rem;
    color: #8a8678;
    text-align: center;
    line-height: 1.5;
  }

  .ms-login-foot {
    margin-top: 44px;
    text-align: center;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.82rem;
    color: #a29e91;
  }

  /* ---------- welcome-back (sesión expirada, paciente conocido) ---------- */
  .ms-welcome-back {
    max-width: 420px;
    margin: 0 auto 28px;
    padding: 16px 20px;
    background: #fdfbf4;
    border: 1px solid #ece7d6;
    border-radius: 16px;
    text-align: center;
    animation: msFade 0.45s ease both;
  }
  .ms-welcome-back-title {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 1.08rem;
    color: #2d2a24;
    margin: 0 0 4px;
    line-height: 1.35;
  }
  .ms-welcome-back-title em {
    font-style: italic;
    font-weight: 600;
    color: var(--color-green);
  }
  .ms-welcome-back-msg {
    font-family: 'Lora', serif;
    font-size: 0.9rem;
    color: #6b6759;
    line-height: 1.55;
    margin: 0;
  }
  .ms-welcome-back-forget {
    display: inline-block;
    margin-top: 10px;
    background: none;
    border: 0;
    padding: 4px 8px;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.82rem;
    color: #8a8678;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ms-welcome-back-forget:hover { color: var(--color-green); }

  /* ============================================================
     AUTHED VIEW
     ============================================================ */
  .ms-authed { padding-top: 4px; }

  .ms-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 44px;
  }
  .ms-hero-text { flex: 1; min-width: 0; }
  .ms-eyebrow {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.92rem;
    color: #8a8678;
    margin-bottom: 4px;
    letter-spacing: 0.01em;
  }
  .ms-greeting {
    font-family: 'Lora', serif;
    font-weight: 400;
    font-size: clamp(1.65rem, 5.4vw, 2rem);
    line-height: 1.12;
    color: #2d2a24;
  }
  .ms-greeting em {
    font-style: italic;
    font-weight: 600;
    color: var(--color-green);
  }

  /* streak — cálido, como un pequeño talismán */
  .ms-streak {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-width: 84px;
    padding: 14px 12px 12px;
    border-radius: 20px;
    background: linear-gradient(180deg, #fff4dc 0%, #ffe2b8 100%);
    box-shadow:
      0 2px 14px rgba(193, 125, 60, 0.14),
      inset 0 1px 0 rgba(255,255,255,0.6);
    text-align: center;
  }
  .ms-flame { width: 22px; height: 22px; color: #c86838; margin-bottom: 1px; }
  .ms-streak-num {
    font-family: 'Lora', serif;
    font-weight: 600;
    font-size: 1.75rem;
    color: #9d4820;
    line-height: 1;
  }
  .ms-streak-label {
    font-size: 0.7rem;
    color: #7a5538;
    letter-spacing: 0.03em;
    margin-top: 2px;
  }

  /* section titles — italic, delicados */
  .ms-section-title {
    font-family: 'Lora', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.02rem;
    color: #8a8678;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-transform: lowercase;
    letter-spacing: 0.01em;
  }
  .ms-section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e4dfcf;
  }

  /* ---------- meals (menú del día) ---------- */
  .ms-today { margin-bottom: 44px; }
  .ms-meals {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ms-meal {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 14px;
    align-items: start;
    padding: 16px 20px;
    background: #fdfbf4;
    border: 1px solid rgba(224, 221, 212, 0.65);
    border-radius: 14px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .ms-meal-time {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.88rem;
    color: var(--color-green);
    padding-top: 3px;
    letter-spacing: 0.015em;
  }
  .ms-meal-text {
    font-size: 0.96rem;
    color: #3e3b34;
    line-height: 1.55;
  }
  .ms-meal.is-skeleton .ms-meal-text {
    color: #a8a394;
    font-style: italic;
  }

  /* ---------- tip del día ---------- */
  .ms-tip {
    margin: -20px 4px 44px;
    padding: 14px 18px 0;
    border-top: 1px solid #ece7d6;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-green-dark);
    text-align: center;
  }
  .ms-tip::before {
    content: "✦ ";
    color: #c8b98a;
    font-style: normal;
    margin-right: 4px;
  }

  /* ---------- check buttons ---------- */
  .ms-check { margin-bottom: 52px; }
  .ms-check-btns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .ms-check-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 18px 8px 16px;
    border: 1.5px solid #e4dfcf;
    background: #fffefa;
    border-radius: 18px;
    cursor: pointer;
    font-family: var(--font-family);
    transition: transform 0.15s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .ms-check-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(50, 40, 20, 0.06);
  }
  .ms-check-btn:focus-visible {
    outline: none;
    border-color: currentColor;
    box-shadow: 0 0 0 3px rgba(74, 124, 89, 0.12);
  }
  .ms-check-btn.is-active {
    border-color: currentColor;
    background: #fdfbf4;
  }
  .ms-check-emoji {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-family: 'Lora', serif;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .ms-check-ok  { color: #4a7c59; }
  .ms-check-ok  .ms-check-emoji { background: #e3efe5; }
  .ms-check-mid { color: #a37a2a; }
  .ms-check-mid .ms-check-emoji { background: #f6ebce; }
  .ms-check-no  { color: #a14d3a; }
  .ms-check-no  .ms-check-emoji { background: #f2dfd7; }
  .ms-check-label {
    font-size: 0.84rem;
    color: #3e3b34;
    font-weight: 500;
  }

  /* ---------- calendar ---------- */
  .ms-calendar { margin-bottom: 48px; }
  .ms-calendar-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    margin-bottom: 10px;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.72rem;
    color: #a29e91;
    text-align: center;
    letter-spacing: 0.05em;
  }
  .ms-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    margin-bottom: 22px;
  }
  .ms-cal-cell {
    aspect-ratio: 1 / 1;
    border: 0;
    border-radius: 50%;
    padding: 0;
    background: #efeadd;
    display: grid;
    place-items: center;
    font-family: 'Lora', serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: #8a8678;
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .ms-cal-cell:not(.is-empty):hover { transform: scale(1.08); }
  .ms-cal-cell:focus-visible {
    outline: 2px solid var(--color-green-dark);
    outline-offset: 2px;
  }
  .ms-cal-cell.is-empty { background: transparent; color: transparent; cursor: default; pointer-events: none; }
  .ms-cal-cell.is-ok,
  .ms-cal-cell.is-mid,
  .ms-cal-cell.is-no { color: #fff; font-weight: 600; }
  .ms-cal-cell.is-ok    { background: var(--color-green); }
  .ms-cal-cell.is-mid   { background: #d9b36a; }
  .ms-cal-cell.is-no    { background: #d9a08e; }
  .ms-cal-cell.is-today {
    box-shadow: 0 0 0 1.5px var(--color-green-dark);
    font-weight: 700;
  }
  .ms-calendar-legend {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.82rem;
    color: #8a8678;
  }
  .ms-legend-dot {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 50%;
    margin-right: 7px;
    vertical-align: baseline;
  }
  .ms-legend-dot.is-ok  { background: var(--color-green); }
  .ms-legend-dot.is-mid { background: #d9b36a; }
  .ms-legend-dot.is-no  { background: #d9a08e; }

  /* ---------- footer ---------- */
  .ms-foot {
    text-align: center;
    padding-top: 12px;
    border-top: 1px solid #e4dfcf;
    margin-top: 24px;
  }
  .ms-signout {
    background: none;
    border: 0;
    cursor: pointer;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.88rem;
    color: #8a8678;
    padding: 10px 16px;
    transition: color 0.2s ease;
  }
  .ms-signout:hover { color: var(--color-green); }

  /* ---------- PDF link in foot ---------- */
  .ms-pdf-link {
    display: inline-block;
    margin-right: 18px;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.88rem;
    color: var(--color-green);
    padding: 10px 2px;
    text-decoration: none;
  }
  .ms-pdf-link:hover { text-decoration: underline; }

  /* ---------- check hint ---------- */
  .ms-check-hint {
    margin: 14px 2px 0;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.86rem;
    color: #8a8678;
    text-align: center;
    line-height: 1.55;
  }

  /* ---------- onboarding modal ---------- */
  .ms-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(45, 42, 36, 0.55);
    display: grid;
    place-items: center;
    padding: 22px;
    z-index: 50;
    animation: msFade 0.3s ease both;
  }
  .ms-modal-backdrop[hidden] { display: none; }
  .ms-modal {
    background: #fffdf6;
    border-radius: 20px;
    padding: 34px 28px 28px;
    max-width: 420px;
    width: 100%;
    box-shadow: 0 18px 48px rgba(45, 42, 36, 0.22);
    text-align: center;
  }
  .ms-modal-title {
    font-family: 'Lora', serif;
    font-weight: 400;
    font-size: 1.55rem;
    line-height: 1.2;
    color: #2d2a24;
    margin: 0 0 10px;
  }
  .ms-modal-title em { font-style: italic; font-weight: 600; color: var(--color-green); }
  .ms-modal-intro {
    font-size: 0.96rem;
    color: #55524a;
    line-height: 1.6;
    margin: 0 0 22px;
  }
  .ms-modal-list {
    text-align: left;
    list-style: none;
    padding: 0;
    margin: 0 0 26px;
    font-size: 0.94rem;
    color: #3e3b34;
    line-height: 1.55;
  }
  .ms-modal-list li {
    padding: 10px 0;
    border-bottom: 1px solid #ece7d6;
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    align-items: start;
  }
  .ms-modal-list li:last-child { border-bottom: 0; }
  .ms-modal-list .ms-modal-ico {
    font-family: 'Lora', serif;
    font-weight: 600;
    text-align: center;
    padding-top: 1px;
  }
  .ms-modal-list .is-ok  { color: #4a7c59; }
  .ms-modal-list .is-mid { color: #a37a2a; }
  .ms-modal-list .is-no  { color: #a14d3a; }
  .ms-modal-list .is-streak { color: #c86838; }
  .ms-modal-ok {
    width: 100%;
    padding: 14px 22px;
    background: var(--color-green);
    color: #fff;
    border: 0;
    border-radius: 14px;
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 0.98rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .ms-modal-ok:hover { background: var(--color-green-dark); }

  /* ---------- day view (reutiliza la UI de hoy) ---------- */
  .ms-back-today {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 14px;
    background: transparent;
    color: var(--color-green);
    border: 1.5px solid var(--color-green);
    border-radius: 999px;
    padding: 7px 16px;
    font-family: var(--font-family);
    font-weight: 500;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .ms-back-today:hover { background: var(--color-green); color: #fff; }

  #ms-authed[data-view="day"] #ms-today-label {
    font-family: 'Lora', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.35rem;
    color: var(--color-green-dark);
    text-transform: none;
  }
  .ms-check-status {
    text-align: center;
    padding: 6px 4px 0;
  }
  .ms-day-badge {
    display: inline-block;
    padding: 8px 20px;
    border-radius: 999px;
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 0.92rem;
    color: #fff;
    margin-bottom: 12px;
  }
  .ms-day-badge.is-ok  { background: var(--color-green); }
  .ms-day-badge.is-mid { background: #d9b36a; }
  .ms-day-badge.is-no  { background: #d9a08e; }
  .ms-day-msg {
    margin: 0;
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.96rem;
    color: #55524a;
    line-height: 1.55;
  }
  .ms-day-msg.is-soft { color: #8a8678; }

  #ms-authed[data-view="today"] .ms-back-today,
  #ms-authed[data-view="today"] .ms-check-status { display: none; }
  #ms-authed[data-view="day"] .ms-tip,
  #ms-authed[data-view="day"] .ms-check-btns,
  #ms-authed[data-view="day"] .ms-check-hint { display: none; }

  /* ============================================================
     LISTA DE LA COMPRA — entry card + vista propia (data-view="compra")
     Estado local: localStorage 'ms-compra-<menu_id>', sin servidor.
     ============================================================ */

  /* Entry card — tras el calendario, siempre visible en vista today/day */
  .ms-compra-entry { margin-bottom: 44px; }
  .ms-compra-cta {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 14px;
    align-items: center;
    width: 100%;
    padding: 16px 18px;
    background: linear-gradient(180deg, #fdfbf4 0%, #f4ecd8 100%);
    border: 1px solid #ece7d6;
    border-radius: 18px;
    cursor: pointer;
    font-family: var(--font-family);
    text-align: left;
    transition: transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .ms-compra-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(74, 124, 89, 0.10);
    border-color: #d9d3c3;
  }
  .ms-compra-cta:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(74, 124, 89, 0.18);
  }
  .ms-compra-cta-icon {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: #e3efe5;
    color: var(--color-green-dark);
  }
  .ms-compra-cta-icon svg { width: 24px; height: 24px; }
  .ms-compra-cta-text { min-width: 0; }
  .ms-compra-cta-title {
    display: block;
    font-family: 'Lora', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.05rem;
    color: #2d2a24;
    line-height: 1.25;
  }
  .ms-compra-cta-meta {
    display: block;
    font-size: 0.82rem;
    color: #8a8678;
    margin-top: 2px;
    letter-spacing: 0.01em;
  }
  .ms-compra-cta-arrow {
    font-family: 'Lora', serif;
