  {# ============================== MILESTONE MODAL ============================== #}
  <div id="ms-milestone" class="ms-modal-backdrop ms-milestone" role="dialog" aria-modal="true" aria-labelledby="ms-milestone-title" hidden>
    <div class="ms-modal">
      <span id="ms-milestone-emoji" class="ms-milestone-emoji" aria-hidden="true">🔥</span>
      <h2 id="ms-milestone-title" class="ms-milestone-title">Una <em>semana</em> seguida</h2>
      <p id="ms-milestone-msg" class="ms-milestone-msg">Siete días cuidándote. Esto ya no es casualidad.</p>
      <button type="button" class="ms-modal-ok" id="ms-milestone-ok">Seguimos</button>
    </div>
  </div>

  {# ============================== INSTALL TUTORIAL (A3) ============================== #}
  <div id="ms-install" class="ms-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="ms-install-title" aria-live="polite" hidden>
    <div class="ms-modal">
      <h2 id="ms-install-title" class="ms-modal-title">Tenlo a <em>un toque</em></h2>
      <p class="ms-modal-intro" id="ms-install-intro">
        Añádelo a tu pantalla de inicio y entras directo, sin buscar nada.
      </p>
      <div id="ms-install-body"></div>
      <div class="ms-modal-actions">
        <button type="button" class="ms-modal-ok" id="ms-install-ok">Ya lo tengo</button>
      </div>
    </div>
  </div>

  {# ============================== IN-APP BROWSER WARN (A4) ============================== #}
  <div id="ms-inapp" class="ms-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="ms-inapp-title" aria-live="polite" hidden>
    <div class="ms-modal">
      <h2 id="ms-inapp-title" class="ms-modal-title">Ábrelo en <em>tu navegador</em></h2>
      <p class="ms-modal-intro" id="ms-inapp-intro">
        Para guardar esta página como app en tu móvil, ábrela en Safari o Chrome.
      </p>
      <div class="ms-modal-actions">
        <button type="button" class="ms-modal-ok" id="ms-inapp-action">Abrir en Chrome</button>
        <button type="button" class="ms-modal-secondary" id="ms-inapp-dismiss">Ahora no</button>
      </div>
    </div>
  </div>

  {# ============================== TOAST ============================== #}
  <div id="ms-toast" class="ms-toast" role="status" aria-live="polite" hidden></div>
</div>

<script type="module">
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

  const SUPABASE_URL = '{{ env.supabaseUrl }}';
  const SUPABASE_KEY = '{{ env.supabasePublishableKey }}';

  const $  = (sel) => document.querySelector(sel);
  const $$ = (sel) => document.querySelectorAll(sel);

  const loadingView = $('#ms-loading');
  const loginView   = $('#ms-login');
  const authedView  = $('#ms-authed');
  const statusEl    = $('#ms-status');
  const form        = $('#ms-login-form');
  const emailInput  = $('#ms-email');
  const submitBtn   = $('#ms-login-submit');
  const otpForm     = $('#ms-otp-form');
  const otpInput    = $('#ms-otp-code');
  const otpSubmit   = $('#ms-otp-submit');
  let pendingOtpEmail = '';
  let firstRenderDone = false;
  let handlersReady   = false;

  function resetOtpUi() {
    pendingOtpEmail = '';
    otpForm.hidden = true;
    otpInput.value = '';
  }

  // Safety net + guard se registran ANTES de createClient para sobrevivir
  // a un throw síncrono (env vars vacías en dev local rompen la URL del
  // cliente y truncarían el resto del script).
  setTimeout(() => {
    if (firstRenderDone) return;
    loadingView.hidden = true;
    loginView.hidden = false;
  }, 4000);

  document.addEventListener('submit', (e) => {
    const t = e.target;
    if (t && (t.id === 'ms-login-form' || t.id === 'ms-otp-form') && !handlersReady) {
      e.preventDefault();
      showStatus('No hemos podido conectar con el servidor. Refresca la página y vuelve a intentarlo.', 'error');
    }
  }, true);

  if (!SUPABASE_URL || !SUPABASE_KEY) throw new Error('Supabase env vars vacías');
  const supa = createClient(SUPABASE_URL, SUPABASE_KEY, {
    auth: {
      persistSession: true,
      autoRefreshToken: true,
      storage: window.localStorage
    }
  });
  window.supa = supa;

  const DIAS_JS = ['domingo','lunes','martes','miercoles','jueves','viernes','sabado'];
  const COMIDAS = [['desayuno','Desayuno'],['almuerzo','Almuerzo'],['comida','Comida'],['merienda','Merienda'],['cena','Cena']];

  let paciente = null;
  let checkinsMap = new Map();
  let menuVigente = null;

  // -------- utils --------
  const capitalize = (s) => s ? s.charAt(0).toUpperCase() + s.slice(1) : '';
  const toISO = (d) => {
    const y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), day = String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${day}`;
  };
  const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  function showStatus(msg, kind) {
    statusEl.hidden = false;
    statusEl.textContent = msg;
    statusEl.classList.remove('is-ok', 'is-error');
    if (kind) statusEl.classList.add('is-' + kind);
  }

  function renderDate() {
    const d = new Date();
    $('#ms-date').textContent  = capitalize(d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' }));
    $('#ms-month').textContent = d.toLocaleDateString('es-ES', { month: 'long' });
  }

  // -------- platform + in-app detection (A3/A4) --------
  function detectPlatform() {
    const ua = (navigator.userAgent || '').toLowerCase();
    if (/iphone|ipad|ipod/.test(ua)) return 'ios';
    // iPadOS 13+ se anuncia como Mac con touch
    if (/macintosh/.test(ua) && navigator.maxTouchPoints > 1) return 'ios';
    if (/android/.test(ua)) return 'android';
    return 'other';
  }
  function isStandalone() {
    try {
      if (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) return true;
      if (window.navigator.standalone === true) return true; // iOS Safari legacy
    } catch (e) { /* noop */ }
    return false;
  }
  function detectInAppBrowser() {
    const ua = navigator.userAgent || '';
    // Instagram, Facebook (FBAN/FBAV), Line, TikTok (musical_ly/Bytedance), LinkedIn, Snapchat,
    // y WebView genérico Android (;?\s?wv\))
    if (/Instagram/i.test(ua)) return 'instagram';
    if (/FBAN|FBAV|FB_IAB/i.test(ua)) return 'facebook';
    if (/\bLine\//i.test(ua)) return 'line';
    if (/musical_ly|Bytedance|TikTok/i.test(ua)) return 'tiktok';
    if (/LinkedInApp/i.test(ua)) return 'linkedin';
    if (/Snapchat/i.test(ua)) return 'snapchat';
    // WebView Android genérica: "; wv)" dentro del UA
    if (/Android.*;\s*wv\)/i.test(ua)) return 'webview';
    return null;
  }

  // -------- retry con backoff (B5) --------
  // Reintenta fn() una vez tras `delay` ms si el error parece transitorio
  // (red caída, 5xx). No reintenta errores de auth (401/403) ni 4xx.
  async function withRetry(fn, opts) {
    const { retries = 1, delay = 700 } = opts || {};
    let lastErr;
    for (let i = 0; i <= retries; i++) {
      try {
        return await fn();
      } catch (err) {
        lastErr = err;
        if (!esErrorTransitorio(err) || i === retries) throw err;
        console.warn('ms-retry', i + 1, err);
        await new Promise(r => setTimeout(r, delay));
      }
    }
    throw lastErr;
  }
  function esErrorTransitorio(err) {
    if (!err) return false;
    // fetch sin respuesta: TypeError "Failed to fetch" / "Load failed"
    if (err instanceof TypeError) return true;
    // Supabase devuelve error con status numérico
    const status = err.status || err.statusCode || (err.context && err.context.status);
    if (typeof status === 'number') {
      if (status >= 500 && status < 600) return true;
      return false; // 4xx no se reintenta
    }
    // Error de red sin status conocido: mensaje típico
    const msg = String(err.message || err).toLowerCase();
    if (/network|fetch|timeout|failed to fetch|load failed/.test(msg)) return true;
    return false;
  }

  // -------- data loaders --------
  async function loadPaciente() {
    const { data, error } = await supa.from('pacientes').select('*').limit(1).maybeSingle();
    if (error) { console.error('pacientes', error); return null; }
    return data;
  }

  async function loadMenuVigente(todayISO) {
    const { data, error } = await supa.from('menus')
      .select('*')
      .lte('vigente_desde', todayISO)
      .order('vigente_desde', { ascending: false })
      .limit(1);
    if (error) { console.error('menus', error); return null; }
    return (data && data[0]) || null;
  }

  async function loadCheckins(fromISO) {
    return withRetry(async () => {
      const { data, error } = await supa.from('checkins')
        .select('fecha, estado')
        .gte('fecha', fromISO)
        .order('fecha', { ascending: false });
      if (error) throw error;
      return data || [];
    }, { retries: 1, delay: 700 });
  }

  async function upsertCheckin(estado) {
    // B4: auto-refresh de sesión antes de escribir. Si el SDK no consigue
    // revalidar el token, devolvemos un sentinel para que el caller vuelva al login.
    const { data: { session } } = await supa.auth.getSession();
    if (!session) return { sessionExpired: true };

    const today = toISO(new Date());
    try {
      await withRetry(async () => {
        const { error } = await supa.from('checkins').upsert({
          paciente_id: paciente.id,
          fecha: today,
          estado
        }, { onConflict: 'paciente_id,fecha' });
        if (error) throw error;
      }, { retries: 1, delay: 700 });
      return { error: null };
    } catch (err) {
      return { error: err };
    }
  }

  // -------- renderers --------
  function renderMeals(menu) {
    const container = $('#ms-meals');
    if (!menu || !menu.contenido) {
      container.innerHTML = `<li class="ms-meal is-skeleton"><span class="ms-meal-time">Aún no hay menú</span><p class="ms-meal-text">En cuanto Cristina lo suba aparecerá aquí.</p></li>`;
      return;
    }
    const hoy = DIAS_JS[new Date().getDay()];
    const dia = menu.contenido.dias && menu.contenido.dias[hoy];
    if (!dia) {
      container.innerHTML = `<li class="ms-meal is-skeleton"><span class="ms-meal-time">Hoy</span><p class="ms-meal-text">Hoy no hay comidas planificadas en este menú.</p></li>`;
      return;
    }
    container.innerHTML = COMIDAS.map(([k, label]) => {
      const text = dia[k] || '—';
      return `<li class="ms-meal"><span class="ms-meal-time">${label}</span><p class="ms-meal-text">${escapeHtml(text)}</p></li>`;
    }).join('');
  }

  // Milestones de racha (días). 28 = MENÚ 1 completo (4 semanas).
  const MILESTONES = [7, 14, 28, 30];

  // Devuelve el mayor milestone alcanzado aún no celebrado, o null.
  function detectarMilestone(racha, vistos) {
    const set = new Set(vistos || []);
    let alcanzado = null;
    for (const m of MILESTONES) {
      if (racha >= m && !set.has(m)) alcanzado = m;
    }
    return alcanzado;
  }

  async function marcarMilestoneVisto(pacienteId, nuevo, actual) {
    const actualizado = [...(actual || []), nuevo];
    const { error } = await supa.from('pacientes')
      .update({ milestones_vistos: actualizado })
      .eq('id', pacienteId);
    if (error) console.error('milestones update', error);
    return actualizado;
  }

  // Racha: cuenta días completados (desde ayer hacia atrás).
  // «lo he seguido» suma 1 · «a medias» mantiene · «hoy no» o sin marcar rompe.
  function renderStreak(checkinsMap) {
    let n = 0;
    const d = new Date(); d.setHours(0,0,0,0);
    d.setDate(d.getDate() - 1); // el día de hoy no cuenta hasta mañana
    while (true) {
      const iso = toISO(d);
      const estado = checkinsMap.get(iso);
      if (estado === 'seguido') {
        n++;
      } else if (estado === 'parcial') {
        // mantiene la racha, no suma
      } else {
        break; // 'no' («hoy no») o día sin marcar rompe la racha
      }
      d.setDate(d.getDate() - 1);
    }
    $('#ms-streak-num').textContent = n;
    $('.ms-streak-label').textContent = n === 1 ? 'día' : 'días';
    return n;
  }

  // Detecta si hay gap entre el último checkin y ayer → racha rota.
  function detectarRachaRota(checkinsMap) {
    const now = new Date(); now.setHours(0, 0, 0, 0);
    const todayISO = toISO(now);
    const yesterdayISO = toISO(new Date(now.getTime() - 864e5));

    let lastISO = null;
    for (const [iso] of checkinsMap) {
      if (iso < todayISO && (!lastISO || iso > lastISO)) lastISO = iso;
    }
    return !!lastISO && lastISO < yesterdayISO;
  }

  function renderCalendar(checkinsMap) {
    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth();
    const firstDay = new Date(year, month, 1);
    const lastDay  = new Date(year, month+1, 0);
    const offset = (firstDay.getDay() + 6) % 7; // Mon=0..Sun=6
    const totalCells = offset + lastDay.getDate();
    const trailing = (7 - (totalCells % 7)) % 7;
    const grid = $('#ms-calendar-grid');
    const todayISO = toISO(now);

    const frag = document.createDocumentFragment();
    for (let i = 0; i < offset; i++) {
      const c = document.createElement('div');
      c.className = 'ms-cal-cell is-empty';
      frag.appendChild(c);
    }
    for (let day = 1; day <= lastDay.getDate(); day++) {
      const iso = `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
      const c = document.createElement('button');
      c.type = 'button';
      c.className = 'ms-cal-cell';
      c.dataset.iso = iso;
      c.setAttribute('aria-label', `Ver el menú del día ${day}`);
      c.textContent = String(day);
      const estado = checkinsMap.get(iso);
      if (estado === 'seguido') c.classList.add('is-ok');
      else if (estado === 'parcial') c.classList.add('is-mid');
      else if (estado === 'no') c.classList.add('is-no');
      if (iso === todayISO) c.classList.add('is-today');
      frag.appendChild(c);
    }
    for (let i = 0; i < trailing; i++) {
      const c = document.createElement('div');
      c.className = 'ms-cal-cell is-empty';
      frag.appendChild(c);
    }
    grid.replaceChildren(frag);
  }

  function setActiveCheck(estado) {
    $$('.ms-check-btn').forEach(b => b.classList.toggle('is-active', b.dataset.estado === estado));
  }

  // -------- day detail (read-only view from calendar tap) --------
  const DAY_STATUS = {
    seguido: { cls: 'is-ok',  label: '«Lo seguí»', msg: 'Un día más cuidándote. Cada uno cuenta.' },
    parcial: { cls: 'is-mid', label: '«A medias»', msg: 'Mantuviste la constancia. Seguir es ganar.' },
    no:      { cls: 'is-no',  label: '«Hoy no»',   msg: 'Un día suelto no te define. Mañana vuelves.' }
  };

  function renderDayMeals(weekday) {
    const dia = menuVigente?.contenido?.dias?.[weekday];
    if (!dia) {
      return `<li class="ms-meal is-skeleton"><span class="ms-meal-time">Sin menú</span><p class="ms-meal-text">No hay menú planificado para este día.</p></li>`;
    }
    return COMIDAS.map(([k, label]) =>
      `<li class="ms-meal"><span class="ms-meal-time">${label}</span><p class="ms-meal-text">${escapeHtml(dia[k] || '—')}</p></li>`
    ).join('');
  }

  function renderDayStatus(iso) {
    const estado = checkinsMap.get(iso);
    const cfg = DAY_STATUS[estado];
    if (cfg) {
      return `<span class="ms-day-badge ${cfg.cls}">${cfg.label}</span><p class="ms-day-msg">${cfg.msg}</p>`;
    }
    const todayISO = toISO(new Date());
    const msg = iso > todayISO
      ? 'Aún está por llegar. Cuando sea, lo marcas.'
      : iso === todayISO
        ? 'Aún no has marcado hoy. Hazlo cuando termines el día.'
        : 'Este día no lo marcaste. Sin drama, sigue tu camino.';
    return `<p class="ms-day-msg is-soft">${msg}</p>`;
  }

  function mostrarDia(iso) {
    if (iso === toISO(new Date())) { mostrarHoy(); return; }
    const [y, m, d] = iso.split('-').map(Number);
    const fecha = new Date(y, m - 1, d);
    const weekday = DIAS_JS[fecha.getDay()];
    $('#ms-today-label').textContent = capitalize(
      fecha.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' })
    );
    $('#ms-check-label').textContent = 'ese día';
    $('#ms-meals').innerHTML = renderDayMeals(weekday);
    $('#ms-check-status').innerHTML = renderDayStatus(iso);
    $('#ms-authed').dataset.view = 'day';
    $('#ms-authed').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function mostrarHoy() {
    $('#ms-today-label').textContent = 'hoy';
    $('#ms-check-label').textContent = '¿cómo ha ido hoy?';
    renderMeals(menuVigente);
    $('#ms-authed').dataset.view = 'today';
    const estado = checkinsMap.get(toISO(new Date()));
    setActiveCheck(estado || null);
  }

  // -------- lista de la compra (localStorage por menú) --------
  // Estado local, sin servidor. Clave `ms-compra-<menu_id>` → al llegar un
  // nuevo menú la clave cambia y la lista vuelve a empezar vacía.
  const CATEGORIAS_COMPRA = [
    'CARNES Y PESCADOS',
    'VERDURAS Y HORTALIZAS',
    'FRUTAS',
    'LÁCTEOS Y HUEVOS',
    'LEGUMBRES Y CEREALES',
    'FRUTOS SECOS Y VARIOS'
  ];

  // Key estable por categoría+texto. Si Cristina reedita el texto de un item,
  // el check se pierde — aceptable, no hay sync ni historial.
  function slugifyItem(categoria, texto) {
    return (categoria + '::' + texto)
      .toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function compraStorageKey(menu) {
    return (menu && menu.id) ? ('ms-compra-' + menu.id) : null;
  }

  function loadCompraState(menu) {
    const key = compraStorageKey(menu);
    if (!key) return new Set();
    try {
      const raw = localStorage.getItem(key);
      if (!raw) return new Set();
      const arr = JSON.parse(raw);
      return new Set(Array.isArray(arr) ? arr : []);
    } catch (e) { return new Set(); }
  }

  function saveCompraState(menu, set) {
    const key = compraStorageKey(menu);
    if (!key) return;
    try { localStorage.setItem(key, JSON.stringify([...set])); }
    catch (e) { /* modo privado o cuota llena: la UI ya está pintada */ }
  }

  let compraState = new Set();
  let compraTotal = 0;

  function getListaCompra(menu) {
    return (menu && menu.contenido && menu.contenido.lista_compra) || {};
  }

  function totalItemsCompra(lista) {
    let n = 0;
    for (const cat of CATEGORIAS_COMPRA) {
      if (Array.isArray(lista[cat])) n += lista[cat].length;
    }
    return n;
  }

  function updateCompraMeta() {
    const meta = $('#ms-compra-meta');
    const prog = $('#ms-compra-progress');
    const actions = $('#ms-compra-actions');
    if (!meta || !prog) return;
    if (compraTotal === 0) {
      meta.textContent = 'Disponible con tu próximo menú';
      prog.textContent = 'Aún no hay lista para esta semana.';
      prog.classList.remove('is-done');
      if (actions) actions.hidden = true;
      return;
    }
    const hechos = compraState.size;
    meta.textContent = hechos === 0
      ? 'Semanal · ' + compraTotal + ' productos'
      : 'Semanal · ' + hechos + '/' + compraTotal + ' comprados';
    if (hechos === compraTotal) {
      prog.textContent = '¡Compra de la semana completa! Buen trabajo.';
      prog.classList.add('is-done');
    } else {
      prog.textContent = hechos + ' de ' + compraTotal + ' comprados esta semana';
      prog.classList.remove('is-done');
    }
    if (actions) actions.hidden = hechos === 0;
  }

  function renderCompra(menu) {
    const container = $('#ms-compra-cats');
    if (!container) return;
    const lista = getListaCompra(menu);
    compraState = loadCompraState(menu);
    compraTotal = totalItemsCompra(lista);

    if (compraTotal === 0) {
      container.innerHTML = '<p class="ms-compra-empty">Aún no hay lista de la compra semanal para este menú.<br>Aparecerá aquí en cuanto Cristina la prepare.</p>';
      updateCompraMeta();
      return;
    }

    const bloques = CATEGORIAS_COMPRA
      .filter(cat => Array.isArray(lista[cat]) && lista[cat].length)
      .map(cat => {
        const items = lista[cat];
        const comprados = items.reduce((n, it) =>
          n + (compraState.has(slugifyItem(cat, it)) ? 1 : 0), 0);
        const total = items.length;
        const countCls = comprados === total ? 'ms-compra-cat-count is-done' : 'ms-compra-cat-count';
        const itemsHtml = items.map(it => {
          const key = slugifyItem(cat, it);
          const done = compraState.has(key);
          return '<li class="ms-compra-item' + (done ? ' is-done' : '') + '" data-key="' + escapeHtml(key) + '">'
            + '<label>'
            + '<input type="checkbox"' + (done ? ' checked' : '') + '>'
            + '<span class="ms-compra-item-text">' + escapeHtml(it) + '</span>'
            + '</label>'
            + '</li>';
        }).join('');
        return '<details class="ms-compra-cat" open>'
          + '<summary class="ms-compra-cat-head">'
          + '<span class="ms-compra-cat-name">' + escapeHtml(cat.toLowerCase()) + '</span>'
          + '<span class="' + countCls + '" data-cat-count>' + comprados + '/' + total + '</span>'
          + '<span class="ms-compra-cat-chevron" aria-hidden="true">▾</span>'
          + '</summary>'
          + '<ul class="ms-compra-items">' + itemsHtml + '</ul>'
          + '</details>';
      }).join('');
    container.innerHTML = bloques;
    updateCompraMeta();
  }

  function setCompraItem(li, done) {
    const key = li.dataset.key;
    if (!key) return;
    if (done) compraState.add(key); else compraState.delete(key);
    li.classList.toggle('is-done', done);
    saveCompraState(menuVigente, compraState);

    const cat = li.closest('.ms-compra-cat');
    if (cat) {
      const count = cat.querySelector('[data-cat-count]');
      const items = cat.querySelectorAll('.ms-compra-item');
      const doneN = cat.querySelectorAll('.ms-compra-item.is-done').length;
      if (count) {
        count.textContent = doneN + '/' + items.length;
        count.classList.toggle('is-done', doneN === items.length);
      }
    }
    updateCompraMeta();
  }

  function mostrarCompra() {
    $('#ms-authed').dataset.view = 'compra';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function reiniciarCompra() {
    if (compraState.size === 0) return;
    const n = compraState.size;
    const ok = window.confirm(
      '¿Empezar la lista de la compra de cero? Se desmarcará ' +
      (n === 1 ? '1 producto.' : n + ' productos.')
    );
    if (!ok) return;
    compraState.clear();
    saveCompraState(menuVigente, compraState);
    renderCompra(menuVigente);
  }

  // pdf_url guarda la ruta dentro del bucket privado (ej. "{uuid}/menu-1.pdf").
  // Firmamos la URL al clic: URL fresca, sin enlaces caducables en el DOM.
  let pdfPathActual = null;
  function renderPdfLink(menu) {
    const link = $('#ms-pdf-link');
    pdfPathActual = (menu && menu.pdf_url) || null;
    link.hidden = !pdfPathActual;
  }
  $('#ms-pdf-link').addEventListener('click', async (e) => {
    if (!pdfPathActual) return;
    if (/^https?:\/\//i.test(pdfPathActual)) return; // ya es URL absoluta
    e.preventDefault();
    const { data, error } = await supa.storage
      .from('menus-pdf')
      .createSignedUrl(pdfPathActual, 60);
    if (error || !data) { console.error('signed url', error); return; }
    window.open(data.signedUrl, '_blank', 'noopener');
  });

  const TIPS = [
    'Hidrátate antes de comer: medio vaso de agua 15 minutos antes ayuda a comer con más calma.',
    'Mastica sin prisa. La saciedad tarda unos 20 minutos en llegar al cerebro.',
    '«A medias» también cuenta. Progreso no es perfección.',
    'Come siempre sentada, sin pantalla delante. El cuerpo se entera mejor de lo que comes.',
    'Si tienes hambre entre horas, bebe agua primero. A veces es sed disfrazada.',
    'Verdura en comida y cena. Media ración como mínimo, cruda o cocinada.',
    'No te saltes el desayuno si tu cuerpo lo pide. Escúchalo, no lo fuerces.',
    'Compra con lista. Si no entra en casa, no se come.',
    'Un plato colorido suele ser un plato completo.',
    'El azúcar que no ves (salsas, panes, yogures) suma más que el que sí ves.',
    'Descansar bien es parte del plan. Dormir poco dispara el hambre del día siguiente.',
