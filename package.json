{
  "name": "crislorentenutricion.github.io",
  "version": "1.0.0",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:build": "node --test tests/build-integrity.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=scripts/** --test-coverage-exclude=tests/** --test-coverage-lines=85 --test-coverage-branches=78 --test-coverage-functions=85 tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crislorentenutricion/crislorentenutricion.github.io.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/crislorentenutricion/crislorentenutricion.github.io/issues"
  },
  "homepage": "https://github.com/crislorentenutricion/crislorentenutricion.github.io#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2"
  }
}
